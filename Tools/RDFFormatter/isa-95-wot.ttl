            ns2:description "Defines the expected use of the material class, material definition, material lot, or material sublot in the context of the process segment."@en ;
            ns2:name "materialUse" ;
            ns2:title "Material use"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "logical" ;
                    ns2:description "the components of the assembly are not necessarily physically connected or in the same area"@en ],
                [ ns1:const "physical" ;
                    ns2:description "the components of the assembly are physically connected or in the same area"@en ] ;
            ns2:description "Defines the type of the assembly"@en ;
            ns2:name "assemblyType" ;
            ns2:title "Assembly type"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Mandatory where a storage location is specified" ;
            ns1:oneOf [ ns6:comment "storage location attribute references an operational location" ;
                    ns1:const "operationalLocation" ;
                    ns2:title "Operational Location"@en ],
                [ ns6:comment "storage location attribute contains a description of the storage location, such as a street address" ;
                    ns1:const "description" ;
                    ns2:title "Description"@en ],
                [ ns6:comment " storage location attribute references a physical asset" ;
                    ns1:const "physicalAsset" ;
                    ns2:title "Physical Asset"@en ],
                [ ns6:comment "storage location attribute references an equipment object" ;
                    ns1:const "equipment" ;
                    ns2:title "Operational Location"@en ] ;
            ns2:description "Indicates whether the storage location attribute refers to an operational location, equipment or physical asset object, or contains a description of the storage location"@en ;
            ns2:name "storageLocationType" ;
            ns2:title "Storage location type"@en ] ;
    ns2:title "Material segment specification"@en .

