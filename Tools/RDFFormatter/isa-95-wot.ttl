            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToDefinitionProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinitionProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
