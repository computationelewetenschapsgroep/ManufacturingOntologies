            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToClassProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClassProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources required"@en ;
            ns2:name "quantity" ;
