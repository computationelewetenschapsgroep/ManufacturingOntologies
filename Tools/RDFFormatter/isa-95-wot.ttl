<dtmi:digitaltwins:isa95:ext:Tags;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.213029+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.220434+01:00"^^xsd:dateTime ;
    ns4:comment "Not part of the AAS meta model. Makes querying easier. See https://docs.microsoft.com/en-us/azure/digital-twins/how-to-use-tags" ;
    ns2:description "You can use the concept of tags to further identify and categorize your digital twins"@en ;
    ns2:hasPropertyAffordance [ a ns5:Map,
                ns1:ObjectSchema ;
            ns1:additionalProperties [ a ns1:StringSchema ] ;
            ns2:description "A value tag is a key-value pair that is used to give each tag a value, such as 'color': 'blue' or 'color': 'red'. Once a value tag is created, it can also be used as a marker tag by ignoring the tag's value."@en ;
            ns2:name "values" ],
        [ a ns5:Map,
                ns1:ObjectSchema ;
            ns1:additionalProperties [ a ns1:BooleanSchema ] ;
            ns2:description "A marker tag is a simple string that is used to mark or categorize a digital twin, such as 'blue' or 'red'. This string is the tag's name, and marker tags have no meaningful value—the tag is significant just by its presence (or absence)."@en ;
            ns2:name "markers" ] ;
    ns2:title "Tags"@en .

