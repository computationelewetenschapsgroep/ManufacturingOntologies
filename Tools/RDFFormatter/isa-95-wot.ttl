<dtmi:digitaltwins:isa95:EvaluatedProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.388028+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.388030+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The evaluated property object identifies the set of testable object / testable object property pairs to be measured and the applicable test method to obtain a property measurement"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The testable object property ID which is to be measured by this test specification" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This test specification criteria used to evaluate the evaluated property of a testable object property" ;
            ns5:displayName "References" ;
            ns3:hasRelationType "dtdl:references" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestSpecificationCriteria;1"^^xsd:anyURI ],
        [ ns5:description "Description of the evaluated property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The work master ID or work directive ID which is applied test method to obtain the measurement of this evaluated property for test specification of the testable object property ID" ;
            ns5:displayName "Measured with method of" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:measuredWithMethodOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkDefinition;1"^^xsd:anyURI ] ;
    ns2:title "Evaluated property"@en .

<dtmi:digitaltwins:isa95:FromResourceReference;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.557179+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.557192+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A 'from' reference to a resource shall be defined as a from resource reference."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the [resource] model as explained in Clause 3.3.8." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToResourceClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the [resource] model as explained in Clause 3.3.8." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToResource" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The to resource reference property(s) defines in part this to resource reference property" ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:FromResourceReferenceProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "physical asset" ],
                [ ns1:const "work master" ],
                [ ns1:const "material sublot" ],
                [ ns1:const "operations segment" ],
                [ ns1:const "equipment class" ],
                [ ns1:const "test result" ],
                [ ns1:const "material definition" ],
                [ ns1:const "personnel class" ],
                [ ns1:const "process segment" ],
                [ ns1:const "test specification" ],
                [ ns1:const "physical asset class" ],
                [ ns1:const "material class" ],
                [ ns1:const "material lot" ],
                [ ns1:const "person" ],
                [ ns1:const "equipment" ],
                [ ns1:const "operation definition" ],
                [ ns1:const "operational location" ] ;
            ns2:description "The type of the resource. "@en ;
            ns2:name "resourceType" ;
            ns2:title "resourceType"@en ] ;
    ns2:title "From resource reference"@en .

<dtmi:digitaltwins:isa95:FromResourceReferenceProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.558989+01:00"^^xsd:dateTime ;
