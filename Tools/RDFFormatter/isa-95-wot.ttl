            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkCalendarEntryProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The work calendar definition entry property that defines this work calendar entry property." ;
            ns5:displayName "Maps to" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkCalendarDefinitionEntryProperty;1"^^xsd:anyURI ;
            ns7:comment "Mandatory - Cardinality 1" ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ] ;
    ns2:title "Work calendar entry property"@en .

<dtmi:digitaltwins:isa95:WorkCalendarProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.574029+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.574035+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The work calendar property shall be defined as property on a work definition property."@en ;
    ns2:hasLink [ ns5:description "Additional information about the work calendar property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The child work calendar properties of this work calendar property." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkCalendarProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ] ;
    ns2:title "Work calendar property"@en .

<dtmi:digitaltwins:isa95:WorkCapability;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.592114+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.592121+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The collection of information about the resources for work for selected future and past times shall be defined as work capability."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The physical asset capability(s) related to this work capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment capability(s) related to this work capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The work master capability(s) related to this work capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfWorkMaster" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkMasterCapability;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the work capability" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The personnel capability(s) related to this work capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelCapability;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material capability(s) related to this work capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The capability end time of this segment response."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Measure of the confidence of the ability to obtain the capacity value."@en ;
            ns2:name "confidenceFactor" ;
            ns2:title "Confidence Factor"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "capacity that is not attainable for future productive use given the equipment condition, equipment utilization, personnel availability or material availability." ;
                    ns1:const "unattainable" ],
                [ ns6:comment "capacity that is available for additional future productive use." ;
                    ns1:const "available" ],
                [ ns6:comment " a historical value that defines the portion of the capacity that was not used or had unacceptable quality." ;
                    ns1:const "unused" ],
                [ ns6:comment "the sum of used and unused capability or the sum of available, unattainable and committed capability." ;
                    ns1:const "total" ],
                [ ns6:comment "a historical value that defines the portion of the capacity with acceptable quality." ;
                    ns1:const "used" ],
                [ ns6:comment ": capacity that is committed for future productive use." ;
                    ns1:const "committed" ] ;
            ns2:description "Defines the type of capability. "@en ;
            ns2:name "capabilityType" ;
            ns2:title "Capability type"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The capability start time of this segment response."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time used for operations capability was published or generated."@en ;
            ns2:name "publishedDate" ;
            ns2:title "Published Date"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the reason for the capability type."@en ;
            ns2:name "reason" ;
            ns2:title "Reason"@en ] ;
    ns2:title "Work capability"@en .

<dtmi:digitaltwins:isa95:WorkCell;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.234552+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.234553+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "Work cells are usually only identified when there is flexibility in the routing of work within a production line."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkUnit;1"^^xsd:anyURI ] ;
    ns2:title "Work cell"@en .

<dtmi:digitaltwins:isa95:WorkCenter;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.233738+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.233739+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "Work centers are elements of the equipment hierarchy under an area. The term work center may be used when the specific type of the equipment element is not significant for the purpose of the discussion."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Reference to a contained work unit of the work center" ;
            ns5:displayName "contains Work unit" ;
            ns3:hasRelationType "dtdl:workUnit" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkUnit;1"^^xsd:anyURI ;
            ns7:comment "Not part of the ISA-95 Standard. Just to make the graph easier to handle" ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SiteAsset;1"^^xsd:anyURI ] ;
    ns2:title "Work center"@en .

<dtmi:digitaltwins:isa95:WorkDefinition;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.594220+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.594230+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "/Abstract/ An identification of the resources and workflow required to perform a specified unit of work shall be defined as a work definition"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The physical asset specification(s) defining part of this operations segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment specification(s) defining part of this operations segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations parameter specifications related to this operations segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsParameter" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ParameterSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material specification(s) defining part of this operations segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The personnel specification(s) defining part of this operations segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelSpecification;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "An identification of the version of the work master version or work directive version. "@en ;
            ns2:name "version" ;
            ns2:title "Version"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "production" ],
                [ ns1:const "maintenance" ],
                [ ns1:const "inventory" ],
                [ ns6:comment " can be used when the activity contains several categories" ;
                    ns1:const "mixed" ],
                [ ns1:const "quality" ] ;
            ns2:description "Describes the category of work."@en ;
            ns2:name "workType" ;
            ns2:title "Work type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Duration, if known"@en ;
            ns2:name "duration" ;
            ns2:title "Duration"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time on which the work master or work directive was published or generated"@en ;
            ns2:name "publishedDate" ;
            ns2:title "Published Date"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The units of measure of the duration, if defined"@en ;
            ns2:name "durationUnitOfMeasure" ;
            ns2:title "Duration unit of measure"@en ] ;
    ns2:title "Work definition"@en .

<dtmi:digitaltwins:isa95:WorkDirective;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.592592+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.592603+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The resources and instructions required to perform a unit of work for a specific job order shall be defined as a work directive."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The work master used to create this work directive." ;
            ns5:displayName "Is Created From" ;
            ns3:hasRelationType "dtdl:isCretaedFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkMaster;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This work directive defined in part by the workflow specification(s)" ;
            ns5:displayName "Has A" ;
            ns3:hasRelationType "dtdl:hasA" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s), work directive, makes up part of this work directive as the whole." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkDirective;1"^^xsd:anyURI ] ;
    ns2:title "Work directive"@en .

<dtmi:digitaltwins:isa95:WorkMaster;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.594878+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.594883+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The resources and instructions required to perform a unit of work without reference to a specific job order shall be defined as a work master"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "This work master(s) includes properties of the parent work master." ;
            ns5:displayName "Includes properties of" ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkMaster;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations defintion(s) associated to this work master" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToDefinition" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:operationDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This work master defined in part by the workflow specification(s)" ;
            ns5:displayName "Has A" ;
            ns3:hasRelationType "dtdl:hasA" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecification;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations segment(s) associated to this work master" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToOperations" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The process segment(s) associated to this work master" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToProcess" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "a work master used as a template for other work masters." ;
                    ns1:const "pattern" ],
                [ ns6:comment ": a work master directly scheduled, dispatched and executed." ;
                    ns1:const "instance" ] ;
            ns2:description "Defines the type of the work master."@en ;
            ns2:name "definitionType" ;
            ns2:title "Definition type"@en ] ;
    ns2:title "Work master"@en .

<dtmi:digitaltwins:isa95:WorkMasterCapability;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.590831+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.590836+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Work master capability has an equivalent structure to the personnel, equipment and material structure of work capability, except the work master capability is defined for a specific work master."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The nested work master capability(s) makes up part of this work master capability as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkMasterCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset capability(s) related to this work master capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material capability(s) related to this work master capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialCapability;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The personnel capability(s) related to this work master capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The work master related to this work master capability." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:workMaster;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment capability(s) related to this work master capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentCapability;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the work master."@en ;
            ns2:name "workMasterID" ;
            ns2:title "Work master ID"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment " a historical value that defines the portion of the capacity that was not used or had unacceptable quality." ;
                    ns1:const "unused" ],
                [ ns6:comment ": capacity that is committed for future productive use." ;
                    ns1:const "committed" ],
                [ ns6:comment "a historical value that defines the portion of the capacity with acceptable quality." ;
                    ns1:const "used" ],
                [ ns6:comment "the sum of used and unused capability or the sum of available, unattainable and committed capability." ;
                    ns1:const "total" ],
                [ ns6:comment "capacity that is available for additional future productive use." ;
                    ns1:const "available" ],
                [ ns6:comment "capacity that is not attainable for future productive use given the equipment condition, equipment utilization, personnel availability or material availability." ;
                    ns1:const "unattainable" ] ;
            ns2:description "Defines the type of capability. "@en ;
            ns2:name "capabilityType" ;
            ns2:title "Capability type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Measure of the confidence of the ability to obtain the capacity value."@en ;
            ns2:name "confidenceFactor" ;
            ns2:title "Confidence Factor"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the reason for the capability type."@en ;
            ns2:name "reason" ;
            ns2:title "Reason"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time of this capability type."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time on which the work master capability was published or generated.."@en ;
            ns2:name "publishedDate" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time of this capability type."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ] ;
    ns2:title "Work master capability"@en .

<dtmi:digitaltwins:isa95:WorkPerformance;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.551170+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.551186+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Work performance shall be defined as a collection of work responses that is a report on requested manufacturing information."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this work performance as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfPerformance" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkPerformance;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "An identification of the associated work schedule." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkSchedule;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The work response(s) related to this work performance." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfResponse" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkResponse;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time of the associated work performance."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "production" ],
                [ ns1:const "inventory" ],
                [ ns1:const "maintenance" ],
                [ ns6:comment " can be used when the activity contains several categories" ;
                    ns1:const "mixed" ],
                [ ns1:const "quality" ] ;
            ns2:description "Describes the category of work."@en ;
            ns2:name "workType" ;
            ns2:title "Work type"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time on which the work performance was published or generated"@en ;
            ns2:name "publishedDate" ;
            ns2:title "Published Date"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time of the associated work performance."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "running" ],
                [ ns1:const "held" ],
                [ ns1:const "waiting" ],
                [ ns1:const "suspended" ],
                [ ns1:const "completed" ],
                [ ns1:const "aborted" ],
                [ ns1:const "ready" ],
                [ ns1:const "closed" ] ;
            ns2:description "Indicates the state of the work performance."@en ;
            ns2:name "workState" ;
            ns2:title "Work state"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Work performance"@en .

<dtmi:digitaltwins:isa95:WorkRecord;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.553239+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.553254+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The work record shall be defined as a subset of the execution and business information that is retained based upon business requirements identified by a work record specification."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Additional information about the work record" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent work record is whole of the child work record(s) as the part." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkRecord;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The work record specification defines the information object(s) allowed to be contained within a work record entry in this work record." ;
            ns5:displayName "Defined by" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:definedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkRecordSpecification;1"^^xsd:anyURI ;
            ns7:comment "Mandatory - Cardinality 1" ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This work record acts as a container for work record entry (s) applying a common action attribute for each work record." ;
            ns5:displayName "Records action on" ;
            ns3:hasRelationType "dtdl:recordsActionOn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkRecordEntry;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The list of IDs of the campaigns associated with the work record."@en ;
            ns2:name "campaignID" ;
            ns2:title "Campaign id"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "Date and time at which the work record is no longer relevant."@en ;
            ns2:name "expiration" ;
            ns2:title "Expiration date"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date of the work record was created."@en ;
            ns2:name "creationDate" ;
            ns2:title "Creation date"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The language used in the work record should be identified."@en ;
            ns2:name "language" ;
            ns2:title "Language"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Also, the change indication enables detection that a work record has been altered, although may not identify the specific alterations." ;
            ns2:description "An indication enabling detection that the work record has not been altered."@en ;
            ns2:name "changeIndication" ;
            ns2:title "Change indication"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the character set to be used in delimiting elements in equipment IDs and procedural element reference."@en ;
            ns2:name "delimiter" ;
            ns2:title "Delimiter"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date of the work record was last changed."@en ;
            ns2:name "lastChangedDate" ;
            ns2:title "Last changed date"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "This is a roll up of detailed information about produced and consumed material lots that are included in other work record entries." ;
            ns2:description "The list of IDs of the products associated with the work record."@en ;
            ns2:name "materialDefinitionID" ;
            ns2:title "Material definition id"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "This is a roll up of detailed information that may be included in other work record entries." ;
            ns2:description "The list of equipment associated with work record."@en ;
            ns2:name "equipmentID" ;
            ns2:title "Equipment id"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The current version of the work record."@en ;
            ns2:name "version" ;
            ns2:title "Version"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "This is a roll up of detailed information about produced and consumed material lots that are included in other work record entries." ;
            ns2:description "The list of IDs of the lots associated with the work record."@en ;
            ns2:name "lotID" ;
            ns2:title "Lot id"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "This is a roll up of detailed information about produced and consumed material lots that are included in other work record entries." ;
            ns2:description "The list of IDs of the batches associated with the work record."@en ;
            ns2:name "batchID" ;
            ns2:title "Batch id"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Current status of the work record. This reflects the current position in a work record’s life cycle."@en ;
            ns2:name "recordStatus" ;
            ns2:title "Record status"@en ] ;
    ns2:title "Work record"@en .

<dtmi:digitaltwins:isa95:WorkRecordEntry;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.555567+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.555576+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The work record entry object shall be a single information object as an object defined in Part 2 and Part 4, and any third-party manufacturing work message profile within a work record ."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "This parent work record entry is whole of the child work record entry(s) as the part." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkRecordEntry;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "An embedded information object. If data is referenced in this work record entry, the attribute is not used. The format of the information object is specified in the work record specification" ;
            ns5:displayName "Corresponds to an entry in" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:correspondsToAnEntryIn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the work record entry " ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The reference to external data (information object) which is stored external to this work record entry. If data is embedded in this work record entry , the attribute is not used. The format of the reference is specified in the work record specification " ;
            ns5:displayName "Corresponds to an entry in" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:correspondsToAnExternalEntryIn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time the publisher recorded / transacted the action. If no entry is provided, the record timestamp is the record timestamp attribute in the work record "@en ;
            ns2:name "recordTimestamp" ;
            ns2:title "Record timestamp"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time that the work record entry was/is effective. If no effective timestamp is provided with work record entry , the effective timestamp is represented by the effective timestamp attribute in the work record "@en ;
            ns2:name "effectiveTimestamp" ;
            ns2:title "Effective timestamp"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The reference to external data (information object) which is stored external to this work record entry . If data is embedded in this work record entry , the attribute is not used. The format of the reference is specified in this work record specification "@en ;
            ns2:name "informationObjectID" ;
            ns2:title "Information object id"@en ],
        [ a ns1:StringSchema ;
            ns2:description "An embedded information object. If data is referenced in this work record entry , the attribute is not used. The format of the information object is specified in this work record specification "@en ;
            ns2:name "informationObject" ;
            ns2:title "Information object"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the type of information object type that a work record entry is based upon. The allowed information object types are defined in the work record specification "@en ;
            ns2:name "informationObjectType" ;
            ns2:title "Information object type"@en ] ;
    ns2:title "Work record entry"@en .

<dtmi:digitaltwins:isa95:WorkRecordSpecification;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.554384+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.554391+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specification of the allowed content of work record objects shall be defined as work record specifications."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent work record specification is whole of the child work record specification(s) as the part." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkRecordSpecification;1"^^xsd:anyURI ],
        [ ns5:description "Additional information and description" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:comment "A work record entry contains the attributes to the information object for work record." ;
            ns2:description "Permitted set of information objects allowed in the work record occurrence."@en ;
            ns2:name "informationObjectModel" ;
            ns2:title "Information object model"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "If no limit is explicitly specified, the unbounded keyword is specified. If no multiplicity entry is specified, this is equivalent to no constraint." ;
            ns2:description "The range of actions allowed to be represented in the work record occurrence."@en ;
            ns2:name "actionMultiplicity" ;
            ns2:title "Action multiplicity"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "added" ],
                [ ns1:const "observed" ],
                [ ns1:const "changed" ],
                [ ns1:const "deleted" ] ;
            ns2:description "The permitted set of actions applied to the work record entry object in the work s record by the publisher."@en ;
            ns2:name "action" ;
            ns2:title "Action"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "If no limit is explicitly specified, the unbounded keyword is specified." ;
            ns2:description "The range of the information object(s) in work record entry allowed in the work record occurrence."@en ;
            ns2:name "informationObjectTypeMultiplicity" ;
            ns2:title "Information object type multiplicity"@en ] ;
    ns2:title "Work record specification"@en .

<dtmi:digitaltwins:isa95:WorkRequest;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.569435+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.569449+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A request for work defined by a set of job orders shall be defined as a work request."@en ;
    ns2:hasLink [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations request(s) related to this work request." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToRequirement" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s), work request, makes up part of this work request as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfRequest" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkRequest;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations request(s) related to this work request." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToRequest" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsRequest;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) job order makes up part of this work request as the whole. Often shared with job list." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfJob" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:JobOrder;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "When work is to be started."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The priority of the work request. "@en ;
            ns2:name "priority" ;
            ns2:title "Priority"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "When work is to be completed."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "released" ],
                [ ns1:const "closed" ],
                [ ns1:const "held" ],
                [ ns1:const "aborted" ],
                [ ns1:const "waiting" ],
                [ ns1:const "cancelled" ],
                [ ns1:const "forecast" ],
                [ ns1:const "suspended" ],
                [ ns1:const "ready" ],
                [ ns1:const "completed" ],
                [ ns1:const "running" ] ;
            ns2:description "Indicates the state of the work schedule."@en ;
            ns2:name "requestState" ;
            ns2:title "Request state"@en ],
        [ a ns1:StringSchema ;
            ns2:description "A unique identification of the segment requirement within the scope of an operations request that specifically relates to the work request."@en ;
            ns2:name "segmentRequirementID" ;
            ns2:title "Segment requirement id"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "production" ],
                [ ns1:const "inventory" ],
                [ ns6:comment " can be used when the activity contains several categories" ;
                    ns1:const "mixed" ],
                [ ns1:const "maintenance" ],
                [ ns1:const "quality" ] ;
            ns2:description "Describes the category of work."@en ;
            ns2:name "workType" ;
            ns2:title "Work type"@en ] ;
    ns2:title "Work request"@en .

<dtmi:digitaltwins:isa95:WorkResponse;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.548507+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.548512+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The responses from manufacturing that are associated with a work request shall be defined as work responses."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The job response(s) that make up this work response." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfJob" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:JobResponse;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "An identification of the associated work request." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkRequest;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s), work response, makes up part of this work response as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfResponse" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkResponse;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time of this work response."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "suspended" ],
                [ ns1:const "closed" ],
                [ ns1:const "completed" ],
                [ ns1:const "ready" ],
                [ ns1:const "waiting" ],
                [ ns1:const "running" ],
                [ ns1:const "aborted" ],
                [ ns1:const "held" ] ;
            ns2:description "Indicates the state of the work response."@en ;
            ns2:name "responseState" ;
            ns2:title "Response state"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time of this work response."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "quality" ],
                [ ns1:const "production" ],
                [ ns6:comment " can be used when the activity contains several categories" ;
                    ns1:const "mixed" ],
                [ ns1:const "maintenance" ],
                [ ns1:const "inventory" ] ;
            ns2:description "Describes the category of work."@en ;
            ns2:name "workType" ;
            ns2:title "Work type"@en ] ;
    ns2:title "Work response"@en .

<dtmi:digitaltwins:isa95:WorkSchedule;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.566900+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.566909+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A request for work shall be listed as a work schedule. A work schedule shall be made up of one or more work requests."@en ;
    ns2:hasLink [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The work request(s) that make up this work schedule." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfRequest" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkRequest;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s), work schedule, makes up part of this work schedule as the whole" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfSchedule" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkSchedule;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time on which the work master or work directive was published or generated"@en ;
            ns2:name "publishedDate" ;
            ns2:title "Published Date"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "cancelled" ],
                [ ns1:const "held" ],
                [ ns1:const "running" ],
                [ ns1:const "suspended" ],
                [ ns1:const "completed" ],
                [ ns1:const "ready" ],
                [ ns1:const "aborted" ],
                [ ns1:const "waiting" ],
                [ ns1:const "forecast" ],
                [ ns1:const "released" ],
                [ ns1:const "closed" ] ;
            ns2:description "Indicates the state of the operations schedule."@en ;
            ns2:name "scheduleState" ;
            ns2:title "Schedule state"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time for the associated work schedule."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time for the associated work schedule."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "maintenance" ],
                [ ns1:const "quality" ],
                [ ns1:const "inventory" ],
                [ ns6:comment " can be used when the activity contains several categories" ;
                    ns1:const "mixed" ],
                [ ns1:const "production" ] ;
            ns2:description "Describes the category of work."@en ;
            ns2:name "workType" ;
            ns2:title "Work type"@en ] ;
    ns2:title "Work schedule"@en .

<dtmi:digitaltwins:isa95:WorkUnit;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.234884+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.234885+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "A work unit is any element of the equipment hierarchy under a work center. Work units are the lowest form of elements in an equipment hierarchy that are typically scheduled by Level 3 functions."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SiteAsset;1"^^xsd:anyURI ] ;
    ns2:title "Work unit"@en .

<dtmi:digitaltwins:isa95:WorkflowSpecification;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.588440+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.588443+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A workflow specification shall be defined as a collection of workflow specification nodes and workflow specification connections."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The workflow specification property(s) in part defines of this workflow specification." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This workflow specification defined in part by this workflow specification node." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfNode" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationNode;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This workflow specification defined in part by the workflow specification connection." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfConnection" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationConnection;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This workflow specification(s) includes the properties of the parent workflow specification." ;
            ns5:displayName "Includes properties of" ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecification;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "pattern" ;
                    ns2:description "a Workflow specification used as a template for other Workflow specifications"@en ],
                [ ns1:const "instance" ;
                    ns2:description "a Workflow specification that may be directly scheduled and tracked"@en ] ;
            ns2:description "Defines the type of the Workflow specification"@en ;
            ns2:name "definitionType" ;
            ns2:title "Definition type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined"@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Workflow specification"@en .

<dtmi:digitaltwins:isa95:WorkflowSpecificationConnection;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.583616+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.583621+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A workflow specification connection represents a many-to-many link between workflow specification nodes."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The workflow specification node connected to this workflow specification connection." ;
            ns5:displayName "Connects to" ;
            ns3:hasRelationType "dtdl:connectsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationNode;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The workflow specification node connected from this workflow specification connection." ;
            ns5:displayName "Connects from" ;
            ns3:hasRelationType "dtdl:connectsFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationNode;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The workflow specification connection defined by this workflow specification connection type." ;
            ns5:displayName "Defined by" ;
            ns3:hasRelationType "dtdl:definedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionType;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The workflow specification connection property(s) defines in part of this workflow specification connection." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Factor used by dependency"@en ;
            ns2:name "dependencyFactor" ;
            ns2:title "Dependency factor"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "noEarlierAfterStart" ;
                    ns2:description "start B no earlier than dependency factor after A start"@en ;
                    ns2:title "No earlier after start"@en ],
                [ ns1:const "notInParallel" ;
                    ns2:description "B may not run in parallel to A"@en ;
                    ns2:title "Not in parallel"@en ],
                [ ns1:const "notFollow" ;
                    ns2:description "B cannot follow A;"@en ;
                    ns2:title "Not follow"@en ],
                [ ns1:const "noEarlierAfterEnd" ;
                    ns2:description " B no earlier than dependency factor after A end"@en ;
                    ns2:title "No earlier after end"@en ],
                [ ns1:const "noLaterAfterStart" ;
                    ns2:description "start B no later than dependency factor after A start"@en ;
                    ns2:title "No later after start"@en ],
                [ ns1:const "afterStart" ;
                    ns2:description "start B after A start"@en ;
                    ns2:title "After start"@en ],
                [ ns1:const "noLaterAfterEnd" ;
                    ns2:description "start B no later than dependency factor after A end"@en ;
                    ns2:title "No later after end"@en ],
                [ ns1:const "atStart" ;
                    ns2:description "start B at A start"@en ;
                    ns2:title "At start"@en ],
                [ ns1:const "afterEnd" ;
                    ns2:description "start B after A end"@en ;
                    ns2:title "After end"@en ],
                [ ns1:const "possibleParallel" ;
                    ns2:description "B may run in parallel to A"@en ;
                    ns2:title "Possible parallel"@en ] ;
            ns2:description "Defines the execution dependency constraints of one workflow specification node to another workflow specification node as the type of the execution or dependency factor between the them. "@en ;
            ns2:name "dependencyType" ;
            ns2:title "Dependency Type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The units of measure of the dependency factor"@en ;
            ns2:name "dependencyFactorUnitOfMeasure" ;
            ns2:title "Dependency factor unit of measure"@en ] ;
    ns2:title "Workflow specification connection"@en .

<dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.588868+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.588872+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A property of a workflow specification connection shall be defined as a workflow specification connection property."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The child workflow specification connection properties of this workflow specification connection property." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionProperty;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "If the workflow specification connection supports a workflow specification connection type, the workflow specification connection type property is applied in this workflow specification connection property(s)." ;
            ns5:displayName "Maps to" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionTypeProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ] ;
    ns2:title "Workflow specification connection property"@en .

<dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionType;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.585169+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.585176+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A workflow specification connection type defines the properties that can be associated with a specific workflow specification connection."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The workflow specification connection type property(s) defines in part this workflow specification connection type.." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionTypeProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Defines the multiplicity of the “from” connection:"@en ;
            ns2:name "fromMultiplicity" ;
            ns2:title "From multiplicity"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the multiplicity of the “to” connection:"@en ;
            ns2:name "toMultiplicity" ;
            ns2:title "To multiplicity"@en ] ;
    ns2:title "Workflow specification connection type"@en .

<dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionTypeProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.586520+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.586528+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A property of a workflow specification connection type shall be defined as a workflow specification connection type property. "@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "If the workflow specification connection supports a workflow specification connection type, this workflow specification connection type property(s) is applied in the workflow specification connection property(s)." ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationConnectionProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The child workflow specification connection type properties of this workflow specification connection type property." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationNodeTypeProperty;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ] ;
    ns2:title "Workflow specification connection type property"@en .

<dtmi:digitaltwins:isa95:WorkflowSpecificationNode;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.585960+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.585965+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A workflow specification node is a step in a workflow."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The work directive defined in part by this workflow specification node." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToWorkDirective" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkDirective;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The work master defined in part by this workflow specification node." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToWorkMaster" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkMaster;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This workflow specification(s) node includes properties the parent workflow specification node." ;
            ns5:displayName "Includes properties of" ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationNode;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This workflow specification node defined in part the workflow specification node property(s)." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationNodeProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The workflow specification defines in part by this workflow specification node as the whole." ;
            ns5:displayName "Contains" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This workflow specification node defined by this workflow specification node type." ;
            ns5:displayName "Defined by" ;
            ns3:hasRelationType "dtdl:definedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationNodeType;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined"@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Workflow specification node"@en .

<dtmi:digitaltwins:isa95:WorkflowSpecificationNodeProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.587201+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.587206+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A property of a workflow specification node shall be defined as a workflow specification node property."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The child workflow specification node properties of this workflow specification node property." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationNodeProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "If the workflow specification node supports a workflow specification node type, the workflow specification node type property is applied in this workflow specification node property(s)." ;
            ns5:displayName "Maps to" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationNodeTypeProperty;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
