                    ns2:title "Destructive sample"@en ],
                [ ns1:const "consumable" ;
                    ns2:title "Consumable"@en ],
                [ ns1:const "returnedSample" ;
                    ns2:title "Returned sample"@en ],
                [ ns1:const "inventoried" ;
                    ns2:title "Inventoried"@en ],
                [ ns1:const "coProductProduced" ;
                    ns2:title "Co-Product produced"@en ],
                [ ns1:const "retainedSample" ;
                    ns2:title "Retained sample"@en ],
                [ ns1:const "materialProduced" ;
                    ns2:title "Material produced"@en ],
