    ns2:title "Physical Asset capability property"@en .

<dtmi:digitaltwins:isa95:PhysicalAssetClass;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.531224+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.531226+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A representation of a grouping of physical assets with similar characteristics for purposes of repair and replacement shall be presented as a physical asset class. Any physical asset shall be a member of one physical asset class. A physical asset class may be defined as a specialization of zero or more physical asset classes. A physical asset class may be made up of zero or more physical asset classes."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "This parent physical asset class is whole of the child physical asset class(s) as the part." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetClass;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the property class asset" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This physical asset class(s) include properties of the physical asset class." ;
            ns5:displayName "Includes properties of" ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetClass;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceClass;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset class property(s) of this physical asset class." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetClassProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "An identification of the manufacturer."@en ;
            ns2:name "manufacturer" ;
            ns2:title "Manufacturer"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Physical Asset class"@en .

<dtmi:digitaltwins:isa95:PhysicalAssetClassProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.527513+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.527520+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of a physical asset class shall be presented as physical asset class properties. Each may have zero or more recognized properties."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceClassProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested physical asset class property(s) makes up part of this physical asset class property as the whole" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetClassProperty;1"^^xsd:anyURI ] ;
    ns2:title "Physical Asset class property"@en .

<dtmi:digitaltwins:isa95:PhysicalAssetProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.527824+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.527826+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of physical assets shall be presented as physical asset properties. A physical asset shall have zero or more physical asset properties. These specify the current property values of the physical asset for the associated physical asset class property. Physical asset properties may include a unit of measure. "@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "If the parent physical asset supports a physical asset class, the physical asset class property(s) is applied in this physical asset property(s).This physical asset property maps to the corresponding physical asset class property." ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetClassProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Dependency" ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested physical asset property(s) makes up part of this physical asset property as the whole." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition hierarchy" ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ] ;
    ns2:title "Physical Asset property"@en .

<dtmi:digitaltwins:isa95:PhysicalAssetRequirement;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.383861+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.383865+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Physical asset resources that are required for a operations segment shall be presented as physical asset specifications"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsTestRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The values in the physical asset requirement property are for this physical asset requirement." ;
            ns5:displayName "has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetRequirementProperty;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this physical asset requirement as the whole" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the physical asset model as explained in Clause 3.3.8. Identifies the associated physical asset or set of physical assets of the specification for a specific process segment. Typically, either physical asset class or physical asset is specified, but not both" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAsset;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to physical location." ;
            ns5:displayName "fits physical location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:physicalLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the physical asset model as explained in Clause 3.3.8. Identifies the associated physical asset class or set of physical asset classes of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToPhysicalAssetClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetClass;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "operationalLocation" ;
                    ns2:description "physical location attribute references an operational location"@en ;
                    ns2:title "Operational Location"@en ],
                [ ns1:const "description" ;
                    ns2:description " physical location attribute contains a description of the physical location, such as a street address."@en ;
                    ns2:title "Description"@en ] ;
            ns2:description "Indicates whether the physical location attribute refers to an operational location object or contains a description of the physical location. Mandatory where a physical location attribute is specified"@en ;
            ns2:name "physicalLocationType" ;
            ns2:title "Physical location type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources required"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "Storage Unit" ;
                    ns2:title "Storage Unit"@en ],
                [ ns1:const "Process Cell" ;
                    ns2:title "Process Cell"@en ],
                [ ns1:const "Area" ],
                [ ns1:const "Production Unit" ;
                    ns2:title "Production Unit"@en ],
                [ ns1:const "Site" ],
                [ ns1:const "Unit" ],
                [ ns1:const "Storage Zone" ;
                    ns2:title "Storage Zone"@en ],
                [ ns1:const "Work Cell" ;
                    ns2:title "Work Cell"@en ],
                [ ns1:const "Enterprise" ],
                [ ns1:const "Work Unit" ;
                    ns2:title "Work Unit"@en ],
                [ ns1:const "Production Line" ;
                    ns2:title "Production Line"@en ],
                [ ns1:const "Work Center" ;
                    ns2:title "Work Center"@en ] ;
            ns2:description "An identification of the level in the role-based equipment hierarchy"@en ;
            ns2:name "equipmentLevel" ;
            ns2:title "Equipment level"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the physical location of the physical asset(s) specified by this physical asset segment specification"@en ;
            ns2:name "physicalLocation" ;
            ns2:title "Physical location"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the expected use of the physical asset class or physical asset in the context of the process segment"@en ;
            ns2:name "physicalAssetUse" ;
            ns2:title "Physical asset use"@en ] ;
    ns2:title "Physical Asset requirement"@en .

<dtmi:digitaltwins:isa95:PhysicalAssetRequirementProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.373460+01:00"^^xsd:dateTime ;
