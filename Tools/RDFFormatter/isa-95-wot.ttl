            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the material resource produced or used by the parent segment"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ] ;
    ns2:title "Material capability property"@en .

<dtmi:digitaltwins:isa95:MaterialClass;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.482516+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.482517+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A representation of groupings of material definitions for a definite purpose such as manufacturing operations definition, scheduling, capability, and performance shall be presented as a material class. A material definition shall belong to zero or more material classes."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material class property(s) of this material class." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClassProperty;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the material class." ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "This material class(s) include properties of the material class." ;
            ns5:displayName "Includes properties of" ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent material class is whole of the child material class(s) as the part." ;
            ns5:displayName "Is assembled from" ;
            ns3:hasRelationType "dtdl:IsAssembledFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClass;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "permanent" ;
                    ns2:description "an assembly that is not intended to be split during the production process"@en ],
                [ ns1:const "transient" ;
                    ns2:description "a temporary assembly using during production, such as a pallet of different materials or a batch kit"@en ] ;
            ns2:description "Defines the type of the relationships"@en ;
            ns2:name "assemblyRelationship" ;
            ns2:title "Assembly relationship"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "logical" ;
                    ns2:description "the components of the assembly are not necessarily physically connected or in the same area"@en ],
                [ ns1:const "physical" ;
                    ns2:description "the components of the assembly are physically connected or in the same area"@en ] ;
            ns2:description "Defines the type of the assembly"@en ;
            ns2:name "assemblyType" ;
            ns2:title "Assembly type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Material class"@en .

<dtmi:digitaltwins:isa95:MaterialClassProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.481536+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.481538+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of a material class shall be presented as material class properties. A material class may define zero or more material class properties. A material class property may be tested to the evaluated property in a test specification where the measured results may be recorded in a property measurement attribute in a test result."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceClassProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested material class property(s) makes up part of this material class property as the whole" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClassProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ] ;
    ns2:title "Material class property"@en .

<dtmi:digitaltwins:isa95:MaterialDefinition;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.483589+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.483592+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A representation of a material with similar characteristics for the purpose of manufacturing operations definition, scheduling, capability and performance shall be presented as a material definition"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The material definition property(s) of this material definition." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinitionProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition" ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This material definition is part of the related object as the whole" ;
            ns5:displayName "Is assembled from" ;
            ns3:hasRelationType "dtdl:isAssembledFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinition;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition" ],
        [ ns5:description "Additional information about the material definition" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This material definition objects support this material class. " ;
            ns5:displayName "Is a member of class" ;
            ns3:hasRelationType "dtdl:isMemberOfClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClass;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Association" ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "permanent" ;
                    ns2:description "an assembly that is not intended to be split during the production process"@en ],
                [ ns1:const "transient" ;
                    ns2:description "a temporary assembly using during production, such as a pallet of different materials or a batch kit"@en ] ;
            ns2:description "Defines the type of the relationships"@en ;
            ns2:name "assemblyRelationship" ;
            ns2:title "Assembly relationship"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "physical" ;
                    ns2:description "the components of the assembly are physically connected or in the same area"@en ],
                [ ns1:const "logical" ;
                    ns2:description "the components of the assembly are not necessarily physically connected or in the same area"@en ] ;
            ns2:description "Defines the type of the assembly"@en ;
            ns2:name "assemblyType" ;
            ns2:title "Assembly type"@en ] ;
    ns2:title "Material definition"@en .

<dtmi:digitaltwins:isa95:MaterialDefinitionProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.484647+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.484655+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of a material definition shall be presented as material definition properties. A material definition may define zero or more material definition properties. A material definition property may be tested to the evaluated property in a test specification where the measured results may be recorded in a property measurement attribute in a test result."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "If the parent material definition supports a material class, the material class property(s) is applied in the material definition property(s). This material definition property maps to the corresponding material class property." ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClassProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Dependency" ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested material definition property(s) makes up part of this material definition property as the whole." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinitionProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "classType" ;
                    ns2:description "The property value is defined for the class and there is no value associated with an instance"@en ;
                    ns2:title "Class Type"@en ],
                [ ns1:const "defaultType" ;
                    ns2:description "The property value is defined for the class as the default instance value, but individual instances of the class may redefine specific values."@en ;
                    ns2:title "Default Type"@en ],
                [ ns1:const "instanceType" ;
                    ns2:description "the property value of the class is undefined"@en ;
                    ns2:title "Instance Type"@en ] ;
            ns2:description "Defines the type of the property."@en ;
            ns2:name "propertyType" ;
            ns2:title "Property type"@en ] ;
    ns2:title "Material definition property"@en .

<dtmi:digitaltwins:isa95:MaterialLot;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.478164+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.478177+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A uniquely identified specific amount of material, either countable or weighable shall be presented as a material lot. A material lot describes the planned or actual total quantity or amount of material available, its current state, and its specific property values"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "This material lot is part of the related object as the whole" ;
            ns5:displayName "Is assembled from" ;
            ns3:hasRelationType "dtdl:isAssembledFromSublot" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSublot;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Aggregation" ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "This material lot is part of the related object as the whole" ;
            ns5:displayName "Is assembled from" ;
            ns3:hasRelationType "dtdl:isAssembledFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialLot;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition" ],
        [ a ns5:Relationship ;
            ns5:description "The material lot property(s) of this material lot" ;
            ns5:displayName "Has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialLotProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition" ],
        [ a ns5:Relationship ;
            ns5:description "The material definition that defines this material lot" ;
            ns5:displayName "Defined by" ;
            ns3:hasRelationType "dtdl:definedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinition;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Association" ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to storage location." ;
            ns5:displayName "fits storage location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:storageLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the material definition" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:comment "Mandatory where a storage location is specified" ;
            ns1:oneOf [ ns6:comment " storage location attribute references a physical asset" ;
                    ns1:const "physicalAsset" ;
                    ns2:title "Physical Asset"@en ],
                [ ns6:comment "storage location attribute references an operational location" ;
                    ns1:const "operationalLocation" ;
                    ns2:title "Operational Location"@en ],
                [ ns6:comment "storage location attribute references an equipment object" ;
                    ns1:const "equipment" ;
                    ns2:title "Operational Location"@en ],
                [ ns6:comment "storage location attribute contains a description of the storage location, such as a street address" ;
                    ns1:const "description" ;
                    ns2:title "Description"@en ] ;
            ns2:description "Indicates whether the storage location attribute refers to an operational location, equipment or physical asset object, or contains a description of the storage location."@en ;
            ns2:name "storageLocationType" ;
            ns2:title "Storage location type"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "The quantity of the material lot. "@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the storage location of the material lot."@en ;
            ns2:name "storageLocation" ;
            ns2:title "Storage location"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "logical" ;
                    ns2:description "the components of the assembly are not necessarily physically connected or in the same area"@en ],
                [ ns1:const "physical" ;
                    ns2:description "the components of the assembly are physically connected or in the same area"@en ] ;
            ns2:description "Defines the type of the assembly"@en ;
            ns2:name "assemblyType" ;
            ns2:title "Assembly type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "planned" ;
                    ns2:description "a material lot that does not yet physically exist, is assigned to an operations request (segment requirement) or work request (Part 4 object) or job order (Part 4 object)"@en ;
                    ns2:title "Planned"@en ],
                [ ns1:const "restricted" ;
                    ns2:description "a material lot is not permitted for normal use due to a restriction condition"@en ;
                    ns2:title "Restricted"@en ],
                [ ns1:const "unrestricted" ;
                    ns2:description "material lot is permitted for normal use without restriction"@en ;
                    ns2:title "Unrestricted"@en ],
                [ ns1:const "inProcess" ;
                    ns2:description "the material lot is in the process of being worked on"@en ;
                    ns2:title "in Process"@en ],
                [ ns1:const "closed" ;
                    ns2:description "material lot has been reconciled as completely consumed, sold or disposed of"@en ;
                    ns2:title "Closed"@en ] ;
            ns2:description "Planning and logistics disposition of a material lot or assembly of material lots. "@en ;
            ns2:name "disposition" ;
            ns2:title "Disposition"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Status of the material lot in manufacturing operations. Values defined by implementation"@en ;
            ns2:name "status" ;
            ns2:title "Status"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "permanent" ;
                    ns2:description "an assembly that is not intended to be split during the production process"@en ],
                [ ns1:const "transient" ;
                    ns2:description "a temporary assembly using during production, such as a pallet of different materials or a batch kit"@en ] ;
            ns2:description "Defines the type of the relationships"@en ;
            ns2:name "assemblyRelationship" ;
            ns2:title "Assembly relationship"@en ] ;
    ns2:title "Material lot"@en .

<dtmi:digitaltwins:isa95:MaterialLotProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.481811+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.481812+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of a material lot shall be presented as material lot properties. Each material can have unique values for zero or more material lot properties, such as a specific pH value for the specific material lot, or a specific density for the material lot"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "If the parent material lot supports a material definition, the material definition property(s) is applied in the material lot property(s)" ;
            ns5:displayName "Maps to" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinitionProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Dependency" ],
        [ a ns5:Relationship ;
            ns5:description "The nested material lot property(s) makes up part of this material lot property as the whole" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialLotProperty;1"^^xsd:anyURI ] ;
    ns2:title "Material lot property"@en .

<dtmi:digitaltwins:isa95:MaterialRequirement;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.382816+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.382817+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "An identification of a material that is expected to be used in the operations request shall be presented as a material requirement"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material definition or set of material definition of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToDefinition" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinition;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The values in the material requirement property are for this material requirement." ;
            ns5:displayName "has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialRequirementProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsTestRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this material requirement as the whole" ;
            ns5:displayName "Is assembled from" ;
            ns3:hasRelationType "dtdl:IsAssembledFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to storage location." ;
            ns5:displayName "fits storage location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:storageLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material class or set of material classes of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material sublot or set of material sublot of the specification for a specific process segment. Typically, either a material class or material definition is specified" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToSublot" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSublot;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material lot or set of material lot of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToLot" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialLot;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this material requirement as the whole" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialRequirement;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "permanent" ;
                    ns2:description "an assembly that is not intended to be split during the production process"@en ],
                [ ns1:const "transient" ;
                    ns2:description "a temporary assembly using during production, such as a pallet of different materials or a batch kit"@en ] ;
            ns2:description "Defines the type of the relationships"@en ;
            ns2:name "assemblyRelationship" ;
            ns2:title "Assembly relationship"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the storage location of  the material resource(s) specified by this material segment specification"@en ;
            ns2:name "storageLocation" ;
            ns2:title "Storage location"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Mandatory where a storage location is specified" ;
            ns1:oneOf [ ns6:comment " storage location attribute references a physical asset" ;
                    ns1:const "physicalAsset" ;
                    ns2:title "Physical Asset"@en ],
                [ ns6:comment "storage location attribute contains a description of the storage location, such as a street address" ;
                    ns1:const "description" ;
                    ns2:title "Description"@en ],
                [ ns6:comment "storage location attribute references an equipment object" ;
                    ns1:const "equipment" ;
                    ns2:title "Operational Location"@en ],
                [ ns6:comment "storage location attribute references an operational location" ;
                    ns1:const "operationalLocation" ;
                    ns2:title "Operational Location"@en ] ;
            ns2:description "Indicates whether the storage location attribute refers to an operational location, equipment or physical asset object, or contains a description of the storage location"@en ;
            ns2:name "storageLocationType" ;
            ns2:title "Storage location type"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the material resource required for the parent segment"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "destructiveSample" ;
                    ns2:title "Destructive sample"@en ],
                [ ns1:const "returnedSample" ;
                    ns2:title "Returned sample"@en ],
                [ ns1:const "inventoried" ;
                    ns2:title "Inventoried"@en ],
                [ ns1:const "byProductProduced" ;
                    ns2:title "By-Product produced"@en ],
                [ ns1:const "consumable" ;
                    ns2:title "Consumable"@en ],
                [ ns1:const "yieldProduced" ;
                    ns2:title "Yield produced"@en ],
                [ ns1:const "materialConsumed" ;
                    ns2:title "Material consumed"@en ],
                [ ns1:const "coProductProduced" ;
