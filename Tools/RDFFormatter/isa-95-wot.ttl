            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ] ;
    ns2:title "From resource reference property"@en .

<dtmi:digitaltwins:isa95:HierarchyScope;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.251811+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.251812+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The hierarchy scope identifies where the exchanged information fits within the role-based equipment hierarchy. It defines the scope of the exchanged information, such as a site or area for ANSI/ISA-95.00.02-2018 – 19 –which the information is relevant. The hierarchy scope identifies the associated instance in the role-based equipment hierarchy. "@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The child hierarchy scope(s) contained within this hierarchy scope." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description " unique identification of an equipment element"@en ;
            ns2:name "equipmentID" ;
            ns2:title "Equipment ID"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "Storage Unit" ;
                    ns2:title "Storage Unit"@en ],
                [ ns1:const "Area" ],
                [ ns1:const "Enterprise" ],
                [ ns1:const "Unit" ],
                [ ns1:const "Site" ],
                [ ns1:const "Storage Zone" ;
                    ns2:title "Storage Zone"@en ],
                [ ns1:const "Work Cell" ;
                    ns2:title "Work Cell"@en ],
                [ ns1:const "Process Cell" ;
                    ns2:title "Process Cell"@en ],
                [ ns1:const "Work Center" ;
                    ns2:title "Work Center"@en ],
                [ ns1:const "Production Unit" ;
                    ns2:title "Production Unit"@en ],
                [ ns1:const "Production Line" ;
                    ns2:title "Production Line"@en ],
                [ ns1:const "Work Unit" ;
                    ns2:title "Work Unit"@en ] ;
            ns2:description "An identification of the level in the role-based equipment hierarchy"@en ;
            ns2:name "equipmentLevel" ;
            ns2:title "Equipment level"@en ] ;
    ns2:title "Hierarchy scope"@en .

<dtmi:digitaltwins:isa95:JobList;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.570580+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.570593+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A job list shall be defined as a collection of job orders for a specific period of time and selected work centers or other resources"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The job orders contained by this job list." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:JobOrder;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time for the associated job list."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time on which the work master or work directive was published or generated"@en ;
            ns2:name "publishedDate" ;
            ns2:title "Published Date"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time for the associated job list."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "inventory" ],
                [ ns1:const "maintenance" ],
                [ ns6:comment " can be used when the activity contains several categories" ;
                    ns1:const "mixed" ],
                [ ns1:const "quality" ],
                [ ns1:const "production" ] ;
            ns2:description "Describes the category of work."@en ;
            ns2:name "workType" ;
            ns2:title "Work type"@en ] ;
    ns2:title "Job list"@en .

<dtmi:digitaltwins:isa95:JobOrder;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.565391+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.565398+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The unit of work requested for execution in a job list and a work request shall be defined as a job order. A job order references an associated work master."@en ;
    ns2:hasLink [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The personnel requirement(s) related to this job order" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The job order parameters related to this job order" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsParameter" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:JobOrderParameter;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The segment requirement(s) within the scope of an operations request that specifically relates to this job order." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToRequirement" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The work master applied to this job order." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToWorkMaster" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkMaster;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment requirement(s) related to this job order" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset requirement(s) related to this job order" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetRequirement;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material requirement(s) related to this job order" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialRequirement;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies the version of the associated work master to be used."@en ;
            ns2:name "workMasterVersion" ;
            ns2:title "Work master version"@en ],
        [ a ns1:StringSchema ;
            ns2:description "A unique identification of the segment requirement within the scope of an operations request that specifically relates to the job order"@en ;
            ns2:name "segmentRequirementID" ;
            ns2:title "Segment requirement id"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "maintenance" ],
                [ ns1:const "quality" ],
                [ ns1:const "inventory" ],
                [ ns6:comment " can be used when the activity contains several categories" ;
                    ns1:const "mixed" ],
                [ ns1:const "production" ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "workType" ;
            ns2:title "Work type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the action the execution management activity is to perform on the job order."@en ;
            ns2:name "command" ;
            ns2:title "Command"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the associated work master to be used"@en ;
            ns2:name "workMasterID" ;
            ns2:title "Work master id"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The priority of the job order. "@en ;
            ns2:name "priority" ;
            ns2:title "Priority"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Instruction to execution management activities specifying conditions to execute the command."@en ;
            ns2:name "commandRule" ;
            ns2:title "Command rule"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "When work is to be started."@en ;
            ns2:name "startTime" ;
            ns2:title "Start time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "When work is to be completed."@en ;
            ns2:name "endTime" ;
            ns2:title "End time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "forecast" ],
                [ ns1:const "released" ],
                [ ns1:const "waiting" ],
                [ ns1:const "held" ],
                [ ns1:const "running" ],
                [ ns1:const "completed" ],
                [ ns1:const "closed" ],
                [ ns1:const "ready" ],
                [ ns1:const "aborted" ],
                [ ns1:const "cancelled" ],
                [ ns1:const "suspended" ] ;
            ns2:description "Identifies the status of the entry from the perspective of the dispatch activity."@en ;
            ns2:name "dispatchStatus" ;
            ns2:title "Dispatch status"@en ] ;
    ns2:title "Job order"@en .

<dtmi:digitaltwins:isa95:JobOrderParameter;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.562764+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.562770+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specific parameters required for a job order shall be presented as job order parameters."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This job order parameter(s) corresponds to the parameter specification(s) in the operations definition." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToSpecification" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ParameterSpecification;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The child job order parameter(s) that are part of this job order parameter." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:JobOrderParameter;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This job order parameter(s) corresponds to the parameter specification(s) in the process segment." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToProcess" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegmentParameter;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The engineering units in which the value is defined. "@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined"@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of acceptable values"@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ] ;
    ns2:title "Job order parameter"@en .

<dtmi:digitaltwins:isa95:JobResponse;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.536981+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.537007+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The responses from manufacturing that are associated with a job order shall be defined as a job response."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The material actual(s) related to this job response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The workflow specification node(s) related to this job response" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToSpecificationNode" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecificationNode;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The job order(s) related to this job response" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToJobOrder" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:JobOrder;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Data associated with this job response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsData" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:JobResponseData;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment actual(s) related to this job response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset actual(s) related to this job response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The work master(s) related to this job response" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToWorkMaster" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkMaster;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The workflow specification(s) related to this job response" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToSpecification" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkflowSpecification;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The personnel actual(s) related to this job response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The work directive(s) related to this job response" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToWorkDirective" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkDirective;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "production" ],
                [ ns1:const "quality" ],
                [ ns6:comment " can be used when the activity contains several categories" ;
                    ns1:const "mixed" ],
                [ ns1:const "inventory" ],
                [ ns1:const "maintenance" ] ;
            ns2:description "Describes the category of work."@en ;
            ns2:name "workType" ;
            ns2:title "Work type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time of this job response."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Job responses may not relate to a job order, it may be a report on all work for a specific time or reported on by plant floor events. " ;
            ns2:description "An identification of the associated job order."@en ;
            ns2:name "jobOrder" ;
            ns2:title "Job order"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "completed" ],
                [ ns1:const "closed" ],
                [ ns1:const "held" ],
                [ ns1:const "ready" ],
                [ ns1:const "running" ],
                [ ns1:const "aborted" ],
                [ ns1:const "suspended" ],
                [ ns1:const "waiting" ] ;
            ns2:description "Indicates the state of the work response."@en ;
            ns2:name "jobState" ;
            ns2:title "Job state"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time of this job response."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ] ;
    ns2:title "Job response"@en .

<dtmi:digitaltwins:isa95:JobResponseData;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.547465+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.547472+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Other information related to the actual work made shall be presented as job response data."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The job response data(s) that are part of this job response data" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:JobResponseData;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition hierarchy" ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The engineering units in which the value is defined. "@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of acceptable values"@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined"@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Job response data"@en .

<dtmi:digitaltwins:isa95:JobResponseList;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.549463+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.549466+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A job response list shall be defined as a collection of job responses for a specific period of time and selected work centers or other resources."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The job response(s) that make up this job response list." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:JobResponse;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time of this job response list."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time of this job response list."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "An identification of the version of the job response list."@en ;
            ns2:name "version" ;
            ns2:title "Version"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment " can be used when the activity contains several categories" ;
                    ns1:const "mixed" ],
                [ ns1:const "quality" ],
                [ ns1:const "inventory" ],
                [ ns1:const "maintenance" ],
                [ ns1:const "production" ] ;
            ns2:description "Describes the category of work."@en ;
            ns2:name "workType" ;
            ns2:title "Work type"@en ] ;
    ns2:title "Job response list"@en .

<dtmi:digitaltwins:isa95:LangStringSet;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.229705+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.229708+01:00"^^xsd:dateTime ;
    ns4:comment "Not part of the ISA95 standard. But enables multi language strings" ;
    ns2:description "A set of strings, each annotated by the language of the string. The meaning of the string in each language shall be the same."@en ;
    ns2:hasPropertyAffordance [ a ns5:Map,
                ns1:ObjectSchema ;
            ns1:additionalProperties [ a ns1:StringSchema ] ;
            ns2:description "A set of strings, each annotated by the language of the string. The meaning of the stringin each language shall be the same."@en ;
            ns2:name "langString" ] ;
    ns2:title "Language String Set"@en .

<dtmi:digitaltwins:isa95:MaterialActual;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.456801+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.456804+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "An identification of a material that was used in the operations request shall be presented as a material actual."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this material actual as the whole" ;
            ns5:displayName "Is assembled from" ;
            ns3:hasRelationType "dtdl:IsAssembledFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material definition or set of material definition of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToDefinition" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material sublot or set of material sublot of the specification for a specific process segment. Typically, either a material class or material definition is specified" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToSublot" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSublot;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material actual property(s) of this material actual" ;
            ns5:displayName "has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialActualProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material class or set of material classes of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClass;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to storage location." ;
            ns5:displayName "fits storage location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:storageLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material lot or set of material lot of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToLot" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialLot;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "physical" ;
                    ns2:description "the components of the assembly are physically connected or in the same area"@en ],
                [ ns1:const "logical" ;
                    ns2:description "the components of the assembly are not necessarily physically connected or in the same area"@en ] ;
            ns2:description "Defines the type of the assembly"@en ;
            ns2:name "assemblyType" ;
            ns2:title "Assembly type"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "destructiveSample" ;
                    ns2:title "Destructive sample"@en ],
                [ ns1:const "inventoried" ;
                    ns2:title "Inventoried"@en ],
                [ ns1:const "retainedSample" ;
                    ns2:title "Retained sample"@en ],
                [ ns1:const "byProductProduced" ;
                    ns2:title "By-Product produced"@en ],
                [ ns1:const "consumable" ;
                    ns2:title "Consumable"@en ],
                [ ns1:const "yieldProduced" ;
                    ns2:title "Yield produced"@en ],
                [ ns1:const "materialProduced" ;
                    ns2:title "Material produced"@en ],
                [ ns1:const "materialConsumed" ;
                    ns2:title "Material consumed"@en ],
                [ ns1:const "coProductProduced" ;
                    ns2:title "Co-Product produced"@en ],
                [ ns1:const "returnedSample" ;
                    ns2:title "Returned sample"@en ] ;
            ns2:description "Defines the use of the material class, material definition, material lot, or material sublot in the context of the process segment."@en ;
            ns2:name "materialUse" ;
            ns2:title "Material use"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of material produced or used by the parent segment."@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Mandatory where a storage location is specified" ;
            ns1:oneOf [ ns6:comment "storage location attribute references an operational location" ;
                    ns1:const "operationalLocation" ;
                    ns2:title "Operational Location"@en ],
                [ ns6:comment " storage location attribute references a physical asset" ;
                    ns1:const "physicalAsset" ;
                    ns2:title "Physical Asset"@en ],
                [ ns6:comment "storage location attribute references an equipment object" ;
                    ns1:const "equipment" ;
                    ns2:title "Operational Location"@en ],
                [ ns6:comment "storage location attribute contains a description of the storage location, such as a street address" ;
                    ns1:const "description" ;
                    ns2:title "Description"@en ] ;
            ns2:description "Indicates whether the storage location attribute refers to an operational location, equipment or physical asset object, or contains a description of the storage location"@en ;
            ns2:name "storageLocationType" ;
            ns2:title "Storage location type"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "transient" ;
                    ns2:description "a temporary assembly using during production, such as a pallet of different materials or a batch kit"@en ],
                [ ns1:const "permanent" ;
                    ns2:description "an assembly that is not intended to be split during the production process"@en ] ;
            ns2:description "Defines the type of the relationships"@en ;
            ns2:name "assemblyRelationship" ;
            ns2:title "Assembly relationship"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the storage location of  the material resource(s) specified by this material segment specification"@en ;
            ns2:name "storageLocation" ;
            ns2:title "Storage location"@en ] ;
    ns2:title "Material actual"@en .

<dtmi:digitaltwins:isa95:MaterialActualProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.473034+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.473037+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specific properties that are required for a material actual shall be presented as material actual properties."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The material actual property(s) of this material actual property" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialActualProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the material model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToLotProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialLotProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the material model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToDefinitionProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinitionProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the material model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToClassProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClassProperty;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions of the property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the material resource produced or used by the parent segment"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ] ;
    ns2:title "Material actual property"@en .

<dtmi:digitaltwins:isa95:MaterialCapability;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.439318+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.439327+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A representation of the capability of material that is committed, available, or unattainable for a specific time shall be presented as a material capability."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material class or set of material classes of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material definition or set of material definition of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToDefinition" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material lot or set of material lot of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToLot" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialLot;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this material capability as the whole" ;
            ns5:displayName "Is assembled from" ;
            ns3:hasRelationType "dtdl:IsAssembledFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to storage location." ;
            ns5:displayName "fits storage location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:storageLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the material model as explained in Clause 3.3.8. Identifies the associated material sublot or set of material sublot of the specification for a specific process segment. Typically, either a material class or material definition is specified" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToSublot" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSublot;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The values in the material capability property are for this material capability." ;
            ns5:displayName "has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSpecificationProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies the storage location of  the material resource(s) specified by this material segment specification"@en ;
            ns2:name "storageLocation" ;
            ns2:title "Storage location"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "physical" ;
                    ns2:description "the components of the assembly are physically connected or in the same area"@en ],
                [ ns1:const "logical" ;
                    ns2:description "the components of the assembly are not necessarily physically connected or in the same area"@en ] ;
            ns2:description "Defines the type of the assembly"@en ;
            ns2:name "assemblyType" ;
            ns2:title "Assembly type"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time associated with the material capability."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of material produced or used by the parent segment."@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the reason for the capability type."@en ;
            ns2:name "reason" ;
            ns2:title "Reason"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "byProductProduced" ;
                    ns2:title "By-Product produced"@en ],
                [ ns1:const "destructiveSample" ;
                    ns2:title "Destructive sample"@en ],
                [ ns1:const "inventoried" ;
                    ns2:title "Inventoried"@en ],
                [ ns1:const "materialConsumed" ;
                    ns2:title "Material consumed"@en ],
                [ ns1:const "materialProduced" ;
                    ns2:title "Material produced"@en ],
                [ ns1:const "retainedSample" ;
                    ns2:title "Retained sample"@en ],
                [ ns1:const "consumable" ;
                    ns2:title "Consumable"@en ],
                [ ns1:const "coProductProduced" ;
                    ns2:title "Co-Product produced"@en ],
                [ ns1:const "returnedSample" ;
                    ns2:title "Returned sample"@en ],
                [ ns1:const "yieldProduced" ;
                    ns2:title "Yield produced"@en ] ;
            ns2:description "Defines the use of the material class, material definition, material lot, or material sublot in the context of the process segment."@en ;
            ns2:name "materialUse" ;
            ns2:title "Material use"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "transient" ;
                    ns2:description "a temporary assembly using during production, such as a pallet of different materials or a batch kit"@en ],
                [ ns1:const "permanent" ;
                    ns2:description "an assembly that is not intended to be split during the production process"@en ] ;
            ns2:description "Defines the type of the relationships"@en ;
            ns2:name "assemblyRelationship" ;
            ns2:title "Assembly relationship"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Mandatory where a storage location is specified" ;
            ns1:oneOf [ ns6:comment "storage location attribute references an equipment object" ;
                    ns1:const "equipment" ;
                    ns2:title "Operational Location"@en ],
                [ ns6:comment "storage location attribute contains a description of the storage location, such as a street address" ;
                    ns1:const "description" ;
                    ns2:title "Description"@en ],
                [ ns6:comment " storage location attribute references a physical asset" ;
                    ns1:const "physicalAsset" ;
                    ns2:title "Physical Asset"@en ],
                [ ns6:comment "storage location attribute references an operational location" ;
                    ns1:const "operationalLocation" ;
                    ns2:title "Operational Location"@en ] ;
            ns2:description "Indicates whether the storage location attribute refers to an operational location, equipment or physical asset object, or contains a description of the storage location"@en ;
            ns2:name "storageLocationType" ;
            ns2:title "Storage location type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Measure of the confidence of the ability to obtain the capacity value."@en ;
            ns2:name "confidenceFactor" ;
            ns2:title "Confidence Factor"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "capacity that is available for additional future productive use." ;
                    ns1:const "available" ],
                [ ns6:comment "capacity that is not attainable for future productive use given the equipment condition, equipment utilization, personnel availability or material availability." ;
                    ns1:const "unattainable" ],
                [ ns6:comment " a historical value that defines the portion of the capacity that was not used or had unacceptable quality." ;
                    ns1:const "unused" ],
                [ ns6:comment "the sum of used and unused capability or the sum of available, unattainable and committed capability." ;
                    ns1:const "total" ],
                [ ns6:comment ": capacity that is committed for future productive use." ;
                    ns1:const "committed" ],
                [ ns6:comment "a historical value that defines the portion of the capacity with acceptable quality." ;
                    ns1:const "used" ] ;
            ns2:description "Defines the type of capability. "@en ;
            ns2:name "capabilityType" ;
            ns2:title "Capability type"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time associated with the material capability."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Material capability"@en .

<dtmi:digitaltwins:isa95:MaterialCapabilityProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.449050+01:00"^^xsd:dateTime ;
