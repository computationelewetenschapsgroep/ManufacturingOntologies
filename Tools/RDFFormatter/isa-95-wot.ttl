@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://www.w3.org/2019/wot/json-schema#> .
@prefix ns2: <https://www.w3.org/2019/wot/td#> .
@prefix ns3: <https://www.w3.org/2019/wot/hypermedia#> .
@prefix ns4: <https://www.w3.org/2019/wot/td#$> .
@prefix ns5: <dtdl:> .
@prefix ns6: <https://www.w3.org/2019/wot/json-schema#$> .
@prefix ns7: <x-jsonschema:$> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<dtmi:digitaltwins:isa95:Area;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.234276+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.234277+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "An area is a physical, geographical, or logical grouping determined by the site. It may contain work centers such as process cells, production units, production lines, and storage zones. Most Level 3 functions occur within the area. The main production capability and geographical location within a site usually identify areas. "@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SiteAsset;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Reference to a contained work center of the area" ;
            ns5:displayName "contains Work center" ;
            ns3:hasRelationType "dtdl:workCenter" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkCenter;1"^^xsd:anyURI ;
            ns7:comment "Not part of the ISA-95 Standard. Just to make the graph easier to handle" ] ;
    ns2:title "Area"@en .

<dtmi:digitaltwins:isa95:BaseModel;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.252399+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.252400+01:00"^^xsd:dateTime ;
    ns4:comment "Not part of the ISA-95 standard" ;
    ns2:description "Abstract base model for all ISA-95 models"@en ;
    ns2:hasLink [ ns5:name "tags" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ext:Tags;1"^^xsd:anyURI ;
            ns7:comment "Not part of the ISA-95 standard. Makes querying easier. See https://docs.microsoft.com/en-us/azure/digital-twins/how-to-use-tags" ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:comment "According to 4.5.5.1 Object identification in ANSI/ISA-95.00.02-2018" ;
            ns2:description "Objects in the information model which require unique identifications contain an ID attribute, which are unique within the scope of the exchanged information"@en ;
            ns2:name "ID" ] ;
    ns2:title "Base ISA-95 model"@en .

<dtmi:digitaltwins:isa95:Enterprise;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.234748+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.234748+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "An enterprise is a collection of sites and areas and represents the top level of a role based equipment hierarchy. The enterprise is responsible for determining what products will be manufactured, at which sites they will be manufactured, and in general how they will be manufactured. "@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SiteAsset;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Reference to a contained site of the enterprise" ;
            ns5:displayName "contains Site" ;
            ns3:hasRelationType "dtdl:site" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Site;1"^^xsd:anyURI ;
            ns7:comment "Not part of the ISA-95 Standard. Just to make the graph easier to handle" ] ;
    ns2:title "Enterprise"@en .

<dtmi:digitaltwins:isa95:Equipment;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.532497+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.532502+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A representation of the elements of the equipment hierarchy model shown in ISA-95.00.01 shall be presented as equipment. Equipment may be a listing of any of the following: enterprise, site, area, work center, work unit, process cell, unit, production line, production unit, work cell, storage zone, and storage unit."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Additional information about the equipment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment property values of this equipment." ;
            ns5:displayName "Has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Equipment classes supported by this equipment." ;
            ns5:displayName "Defined by" ;
            ns3:hasRelationType "dtdl:definedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClass;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Association" ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This equipment as role in a process segment is implemented by the physical asset." ;
            ns5:displayName "Implemented by" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:implementedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAsset;1"^^xsd:anyURI ;
            ns7:comment "For Equipment asset mapping" ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this equipment as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Equipment;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "processCell" ;
                    ns2:title "Process Cell"@en ],
                [ ns1:const "workUnit" ;
                    ns2:title "Work Unit"@en ],
                [ ns1:const "storageZone" ;
                    ns2:title "Storage Zone"@en ],
                [ ns1:const "Storage Unit" ;
                    ns2:title "Storage Unit"@en ],
                [ ns1:const "productionUnit" ;
                    ns2:title "Production Unit"@en ],
                [ ns1:const "area" ;
                    ns2:title "Area"@en ],
                [ ns1:const "productionLine" ;
                    ns2:title "Production Line"@en ],
                [ ns1:const "site" ;
                    ns2:title "Site"@en ],
                [ ns1:const "unit" ;
                    ns2:title "Unit"@en ],
                [ ns1:const "workCell" ;
                    ns2:title "Work Cell"@en ],
                [ ns1:const "workCenter" ;
                    ns2:title "Work Center"@en ],
                [ ns1:const "enterprise" ;
                    ns2:title "Enterprise"@en ] ;
            ns2:description "An identification of the level in the role-based equipment hierarchy"@en ;
            ns2:name "equipmentLevel" ;
            ns2:title "Equipment level"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Equipment"@en .

<dtmi:digitaltwins:isa95:EquipmentActual;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.460057+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.460074+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "An identification of an equipment capability used during a specified segment shall be presented as an equipment actual."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the equipment model as explained in Clause 3.3.8. Identifies the associated equipment or set of equipment of the specification for a specific process segment. Typically, either equipment class or equipment is defined" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Equipment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The values in the equipment actual property are for this equipment actual." ;
            ns5:displayName "has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentActualProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this equipment actual as the whole" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentActual;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the equipment model as explained in Clause 3.3.8. Identifies the associated equipment class or set of equipment classes of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToEquipmentClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClass;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to operational location." ;
            ns5:displayName "fits operational location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:operationalLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies the operational location of the equipment specified by this equipment segment specification"@en ;
            ns2:name "operationalLocation" ;
            ns2:title "Operational location"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources used in the parent segment"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "operationalLocation" ;
                    ns2:description "operational location attribute references an operational location;"@en ;
                    ns2:title "Operational Location"@en ],
                [ ns1:const "description" ;
                    ns2:description "operational location attribute contains a description of the operational location, such as a street address."@en ;
                    ns2:title "Description"@en ] ;
            ns2:description "Indicates whether the operational location attribute refers to an operational location object or contains a description of the operational location. Mandatory where an operational location attribute is specified"@en ;
            ns2:name "operationalLocationType" ;
            ns2:title "Operational location type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the actual use of the equipment class or equipment"@en ;
            ns2:name "equipmentUse" ;
            ns2:title "Equipment use"@en ] ;
    ns2:title "Equipment actual"@en .

<dtmi:digitaltwins:isa95:EquipmentActualProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.472273+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.472276+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specific properties that are required for an equipment actual shall be presented as equipment actual properties."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The equipment actual property(s) of this equipment actual property" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentActualProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the equipment model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the equipment model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToClassProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClassProperty;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions of the property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources used"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ] ;
    ns2:title "Equipment actual property"@en .

<dtmi:digitaltwins:isa95:EquipmentAssetMapping;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.528630+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.528633+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The relationship between a physical asset and an equipment shall be presented as an equipment asset mapping. The equipment asset mapping records the time period when one equipment object and one physical asset object were associated."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment performing the manufacturing function." ;
            ns5:displayName "Records use of" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:RecordsUseOfEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Equipment;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the mapping element." ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset that is associated  with the equipment if the physical asset associated with a manufacturing function" ;
            ns5:displayName "Records use of" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:RecordsUseOfPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAsset;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined"@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time of the association. "@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time of the association."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ] ;
    ns2:title "Equipment asset mapping"@en .

<dtmi:digitaltwins:isa95:EquipmentCapability;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.447176+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.447204+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A representation of the capability of equipment or equipment classes that is committed, available, or unattainable for a specific time shall be presented as an equipment capability."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this equipment capability as the whole" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to operational location." ;
            ns5:displayName "fits operational location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:operationalLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the equipment model as explained in Clause 3.3.8. Identifies the associated equipment class or set of equipment classes of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToEquipmentClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The values in the equipment capability property are for this equipment capability." ;
            ns5:displayName "has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentCapabilityProperty;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the equipment model as explained in Clause 3.3.8. Identifies the associated equipment or set of equipment of the specification for a specific process segment. Typically, either equipment class or equipment is defined" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Equipment;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time associated with the equipment capability."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time associated with the equipment capability."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "the sum of used and unused capability or the sum of available, unattainable and committed capability." ;
                    ns1:const "total" ],
                [ ns6:comment " a historical value that defines the portion of the capacity that was not used or had unacceptable quality." ;
                    ns1:const "unused" ],
                [ ns6:comment ": capacity that is committed for future productive use." ;
                    ns1:const "committed" ],
                [ ns6:comment "a historical value that defines the portion of the capacity with acceptable quality." ;
                    ns1:const "used" ],
                [ ns6:comment "capacity that is not attainable for future productive use given the equipment condition, equipment utilization, personnel availability or material availability." ;
                    ns1:const "unattainable" ],
                [ ns6:comment "capacity that is available for additional future productive use." ;
                    ns1:const "available" ] ;
            ns2:description "Defines the type of capability. "@en ;
            ns2:name "capabilityType" ;
            ns2:title "Capability type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the reason for the capability type."@en ;
            ns2:name "reason" ;
            ns2:title "Reason"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the capability use of the equipment class or equipment"@en ;
            ns2:name "equipmentUse" ;
            ns2:title "Equipment use"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Measure of the confidence of the ability to obtain the capacity value."@en ;
            ns2:name "confidenceFactor" ;
            ns2:title "Confidence Factor"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources used in the parent segment"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "description" ;
                    ns2:description "operational location attribute contains a description of the operational location, such as a street address."@en ;
                    ns2:title "Description"@en ],
                [ ns1:const "operationalLocation" ;
                    ns2:description "operational location attribute references an operational location;"@en ;
                    ns2:title "Operational Location"@en ] ;
            ns2:description "Indicates whether the operational location attribute refers to an operational location object or contains a description of the operational location. Mandatory where an operational location attribute is specified"@en ;
            ns2:name "operationalLocationType" ;
            ns2:title "Operational location type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the operational location of the equipment specified by this equipment segment specification"@en ;
            ns2:name "operationalLocation" ;
            ns2:title "Operational location"@en ] ;
    ns2:title "Equipment capability"@en .

<dtmi:digitaltwins:isa95:EquipmentCapabilityProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.437177+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.437183+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specific properties that are required for an equipment capability shall be presented as equipment capability properties."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the equipment model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToClassProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClassProperty;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions of the property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment capability property(s) of this equipment capability property" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentCapabilityProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the equipment model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources used"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ] ;
    ns2:title "Equipment capability property"@en .

<dtmi:digitaltwins:isa95:EquipmentClass;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.534152+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.534170+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A representation of a grouping of equipment with similar characteristics for a definite purpose such as manufacturing operations definition, scheduling, capability and performance shall be presented as an equipment class. Any piece of equipment may be a member of zero or more equipment classes. An equipment class may be defined as a specialization of zero or more equipment classes. An equipment class may be made up of zero or more equipment classes."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "This equipment class(s) include properties of the equipment class." ;
            ns5:displayName "Includes properties of" ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClass;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent equipment class is whole of the child equipment class(s) as the part." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClass;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the equipment class" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment class property(s) of this equipment class." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClassProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "Storage Unit" ;
                    ns2:title "Storage Unit"@en ],
                [ ns1:const "productionUnit" ;
                    ns2:title "Production Unit"@en ],
                [ ns1:const "workCell" ;
                    ns2:title "Work Cell"@en ],
                [ ns1:const "workCenter" ;
                    ns2:title "Work Center"@en ],
                [ ns1:const "site" ;
                    ns2:title "Site"@en ],
                [ ns1:const "workUnit" ;
                    ns2:title "Work Unit"@en ],
                [ ns1:const "productionLine" ;
                    ns2:title "Production Line"@en ],
                [ ns1:const "unit" ;
                    ns2:title "Unit"@en ],
                [ ns1:const "processCell" ;
                    ns2:title "Process Cell"@en ],
                [ ns1:const "storageZone" ;
                    ns2:title "Storage Zone"@en ],
                [ ns1:const "area" ;
                    ns2:title "Area"@en ],
                [ ns1:const "enterprise" ;
                    ns2:title "Enterprise"@en ] ;
            ns2:description "An identification of the level in the role-based equipment hierarchy"@en ;
            ns2:name "equipmentLevel" ;
            ns2:title "Equipment level"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Equipment class"@en .

<dtmi:digitaltwins:isa95:EquipmentClassProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.527988+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.527990+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "An equipment class property may be tested to the evaluated property in a test specification where the measured results may be recorded in a property measurement attribute in a test result. The measured results may also be evaluated to the test specification criteria in the test specification that references the evaluated property where they may be recorded in an evaluated criterion result attribute in the test result. Equipment class properties may contain nested equipment class properties."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceClassProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested equipment class property(s) makes up part of thisequipment class property as the whole" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClassProperty;1"^^xsd:anyURI ] ;
    ns2:title "Equipment class property"@en .

<dtmi:digitaltwins:isa95:EquipmentProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.530470+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.530476+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of equipment shall be presented as equipment properties. An equipment shall have zero or more equipment properties. These specify the current property values of the equipment for the associated equipment class property."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested equipment property(s) makes up part of this equipment property as the whole." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition hierarchy" ],
        [ a ns5:Relationship ;
            ns5:description "If the parent equipment supports an equipment class, the equipment class property(s) is applied in this equipment property(s)." ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClassProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Dependency" ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceProperty;1"^^xsd:anyURI ] ;
    ns2:title "Equipment property"@en .

<dtmi:digitaltwins:isa95:EquipmentRequirement;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.376171+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.376177+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The identification of the number, type, duration, and scheduling of specific equipment and equipment classifications or equipment constraints needed to support the c urrent operations request shall be presented as an equipment requirement"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsTestRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the equipment model as explained in Clause 3.3.8. Identifies the associated equipment class or set of equipment classes of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToEquipmentClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentClass;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to operational location." ;
            ns5:displayName "fits operational location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:operationalLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The values in the equipment requirement property are for this equipment requirement." ;
            ns5:displayName "has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentRequirementProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the equipment model as explained in Clause 3.3.8. Identifies the associated equipment or set of equipment of the specification for a specific process segment. Typically, either equipment class or equipment is defined" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Equipment;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this equipment requirement as the whole" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentRequirement;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "Enterprise" ],
                [ ns1:const "Production Line" ;
                    ns2:title "Production Line"@en ],
                [ ns1:const "Storage Unit" ;
                    ns2:title "Storage Unit"@en ],
                [ ns1:const "Site" ],
                [ ns1:const "Unit" ],
                [ ns1:const "Area" ],
                [ ns1:const "Production Unit" ;
                    ns2:title "Production Unit"@en ],
                [ ns1:const "Work Center" ;
                    ns2:title "Work Center"@en ],
                [ ns1:const "Work Unit" ;
                    ns2:title "Work Unit"@en ],
                [ ns1:const "Work Cell" ;
                    ns2:title "Work Cell"@en ],
                [ ns1:const "Process Cell" ;
                    ns2:title "Process Cell"@en ],
                [ ns1:const "Storage Zone" ;
                    ns2:title "Storage Zone"@en ] ;
            ns2:description "An identification of the level in the role-based equipment hierarchy"@en ;
            ns2:name "equipmentLevel" ;
            ns2:title "Equipment level"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the expected use of the equipment class or equipment in the context of the process segment"@en ;
            ns2:name "equipmentUse" ;
            ns2:title "Equipment use"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the operational location of the equipment specified by this equipment segment specification"@en ;
            ns2:name "operationalLocation" ;
            ns2:title "Operational location"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "operationalLocation" ;
                    ns2:description "operational location attribute references an operational location;"@en ;
                    ns2:title "Operational Location"@en ],
                [ ns1:const "description" ;
                    ns2:description "operational location attribute contains a description of the operational location, such as a street address."@en ;
                    ns2:title "Description"@en ] ;
            ns2:description "Indicates whether the operational location attribute refers to an operational location object or contains a description of the operational location. Mandatory where an operational location attribute is specified"@en ;
            ns2:name "operationalLocationType" ;
            ns2:title "Operational location type"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources required"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ] ;
    ns2:title "Equipment requirement"@en .

<dtmi:digitaltwins:isa95:EquipmentRequirementProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.373966+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.373968+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specific properties that are required for equipment requirements shall be presented as equipment requirement properties"@en ;
