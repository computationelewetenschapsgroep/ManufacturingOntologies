            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested resource network connection type properties of this network connection type property." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceNetworkConnectionTypeProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ] ;
    ns2:title "Resource network connection type property"@en .

<dtmi:digitaltwins:isa95:ResourceProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.253042+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.253043+01:00"^^xsd:dateTime ;
    ns2:description "Abstract model for all resource property models (person, equipment, physical asset, material definition, material lot, material sublot, work master, process segment, operation definition, operational location, operations segment, test specification, test result)"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the resource property." ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ] ;
    ns2:title "Resource property"@en .

<dtmi:digitaltwins:isa95:ResourceRelationshipNetwork;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.560303+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.560314+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A resource relationship network shall be a composition of one or more resource network connections."@en ;
    ns2:hasLink [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The resource network connections related to this resource relationship network as a whole." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceNetworkConnection;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The resource relationship network property(s) of this resource relationship network." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceRelationshipNetworkProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "the elements of the relationship are not necessarily physically connected or in the same area. " ;
                    ns1:const "logical" ],
                [ ns6:comment "the elements of the relationship are physically connected or in the same area" ;
                    ns1:const "physical" ] ;
            ns2:description "Defines the type of relationship. "@en ;
            ns2:name "relationshipType" ;
            ns2:title "Relationship Type"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "the elements of the relationship are not necessarily physically connected or in the same area. " ;
                    ns1:const "transient" ],
                [ ns6:comment "the relationship is not intended to be split or changed during operations processes;" ;
                    ns1:const "permanent" ] ;
            ns2:description "Defines the form of the relationships.  "@en ;
            ns2:name "relationshipForm" ;
            ns2:title "Relationship Form"@en ] ;
    ns2:title "Resource relationship network"@en .

<dtmi:digitaltwins:isa95:ResourceRelationshipNetworkProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.558534+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.558537+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A resource relationship network property may contain nested resource relationship network property(s)."@en ;
    ns2:hasLink [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested resource relationship network properties of this resource relationship network property." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceRelationshipNetworkProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ] ;
    ns2:title "Resource relationship network property"@en .

<dtmi:digitaltwins:isa95:SegmentData;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.457634+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.457645+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Other information related to the actual operations made shall be presented as segment data."@en ;
    ns2:hasLink [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The segment data(s) that are part of this segment data" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentData;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition hierarchy" ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The engineering units in which the value is defined. "@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined"@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of acceptable values"@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ] ;
    ns2:title "Segment data"@en .

<dtmi:digitaltwins:isa95:SegmentParameter;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.372888+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.372892+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specific parameters required for a segment requirement shall be presented as segment parameters."@en ;
    ns2:hasLink [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The segment parameter(s) that are part of this segment parameter as the whole." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentParameter;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition hierarchy" ],
        [ a ns5:Relationship ;
            ns5:description "This segment data(s) corresponds to the process segment parameter(s) in the process segment." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToProcess" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegmentParameter;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This segment data(s) corresponds to the parameter specification(s) in the operations definition." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToSpecification" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ParameterSpecification;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The engineering units in which the value is defined. "@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of acceptable values"@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined"@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Segment parameter"@en .

<dtmi:digitaltwins:isa95:SegmentRequirement;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.371876+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.371884+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "An operations request shall be made up of one or more segment requirements. Each segment requirement shall correspond to, or reference, an identified operations definition, operations segment or process segment. T"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The personnel requirement(s) related to this segment requirement" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The segment parameters related to this segment requirement" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsParameter" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentParameter;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations definition reference that corresponds to this segment requirement" ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToDefinition" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsDefinition;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this segment requirement as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The associated operations segments that corresponds to this segment requirement" ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToSegment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment requirement(s) related to this segment requirement" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "An identification of the process segment associated with this segment requirement." ;
            ns5:displayName "Corresponds To a" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:correspondsToAProcessSegment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material requirement(s) related to this segment requirement" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset requirement(s) related to this segment requirement" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetRequirement;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The expected latest ending time of this segment requirement."@en ;
            ns2:name "latestEndTime" ;
            ns2:title "Latest End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The expected earliest start time of this segment requirement."@en ;
            ns2:name "earliestStartTime" ;
            ns2:title "Earliest Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The units of measure of the duration"@en ;
            ns2:name "durationUnitOfMeasure" ;
            ns2:title "Duration unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The expected duration of this segment requirement. "@en ;
            ns2:name "duration" ;
            ns2:title "Duration"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "suspended" ],
                [ ns1:const "closed" ],
                [ ns1:const "aborted" ],
                [ ns1:const "cancelled" ],
                [ ns1:const "running" ],
                [ ns1:const "completed" ],
                [ ns1:const "ready" ],
                [ ns1:const "waiting" ],
                [ ns1:const "forecast" ],
                [ ns1:const "held" ],
                [ ns1:const "released" ] ;
            ns2:description "Indicates the state of the operations schedule."@en ;
            ns2:name "segmentState" ;
            ns2:title "Schedule state"@en ] ;
    ns2:title "Segment requirement"@en .

<dtmi:digitaltwins:isa95:SegmentResponse;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.454901+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.454908+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Information on a segment of an operations response shall be presented as a segment response."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The personnel actual(s) related to this segment response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this segment response as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentResponse;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment actual(s) related to this segment response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "An identification of the process segment associated with this segment response." ;
            ns5:displayName "Corresponds To a" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:correspondsToAProcessSegment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The segment parameters related to this segment response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsData" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentData;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations definition reference that corresponds to this segment response" ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToDefinition" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The associated operations segments that corresponds to this segment response" ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToSegment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The segments requirement(s) that corresponds to this segment response" ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToRequirement" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentRequirement;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material actual(s) related to this segment response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset actual(s) related to this segment response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetActual;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The actual end time of this segment response"@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The actual start time of this segment response"@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "suspended" ],
                [ ns1:const "closed" ],
                [ ns1:const "held" ],
                [ ns1:const "forecast" ],
                [ ns1:const "ready" ],
                [ ns1:const "waiting" ],
                [ ns1:const "cancelled" ],
                [ ns1:const "running" ],
                [ ns1:const "released" ],
                [ ns1:const "aborted" ],
                [ ns1:const "completed" ] ;
            ns2:description "Indicates the state of the segment response."@en ;
            ns2:name "segmentState" ;
            ns2:title "Segment state"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time used for posting resource actuals to supporting applications."@en ;
            ns2:name "postingDate" ;
            ns2:title "Posting Date"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Segment response"@en .

<dtmi:digitaltwins:isa95:Site;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.234991+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.234991+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "A site is a physical, geographical, or logical grouping determined by the enterprise. It may contain areas, production lines, process cells, and production units. The Level 4 functions at a site are involved in local site management and optimization. Site planning and scheduling may involve work centers or work units within the areas. "@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Reference to a contained area of the site" ;
            ns5:displayName "contains Area" ;
            ns3:hasRelationType "dtdl:area" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Area;1"^^xsd:anyURI ;
            ns7:comment "Not part of the ISA-95 Standard. Just to make the graph easier to handle" ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SiteAsset;1"^^xsd:anyURI ] ;
    ns2:title "Site"@en .

<dtmi:digitaltwins:isa95:SiteAsset;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.234422+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.234423+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "An Abstract site asset in the physical asset equipment hierarchy"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ] ;
    ns2:title "Site asset"@en .

<dtmi:digitaltwins:isa95:SpatialDefinition;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.252813+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.252815+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The spatial definition provides a means of communicating zero-dimensional point, one-dimensional line, or two-dimensional shape or three-dimensional solid geospatial location data for planning/scheduling, actuals, resources, and analytics."@en ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "An enumerator that determines the format of the value attribute. E.g. GPX, WKT, ..."@en ;
            ns2:name "format" ;
            ns2:title "Format"@en ],
        [ a ns1:StringSchema ;
            ns2:description "A string to uniquely identify a spatial definition. EXAMPLE 1 UN/CEFACT CCTS: TextType) of the geospatial information in the format indicated in the format attribute."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "SRID is the Spatial Reference Identifier which identifies the coordinate reference system to identify a predefined coordinate"@en ;
            ns2:name "SRID" ],
        [ a ns1:StringSchema ;
            ns2:description "The SRID authority identifies the authority that defines the coordinate reference system identified by the SRID. "@en ;
            ns2:name "SRIDauthority" ;
            ns2:title "SRID authority"@en ] ;
    ns2:title "Spatial definition"@en .

<dtmi:digitaltwins:isa95:StorageUnit;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.234820+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.234821+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "Storage zones and storage units are the lowest level of material movement equipment typically scheduled by the Level 4 and Level 3 functions for discrete, batch and continuous manufacturing processes. A storage zone is a type of work center and a storage unit is a type of work unit that is organized as elements within an area. These are the lower-level elements of an equipment hierarchy used in material storage and movement activities. "@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkUnit;1"^^xsd:anyURI ] ;
    ns2:title "Storage unit"@en .

<dtmi:digitaltwins:isa95:StorageZone;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.231259+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.231260+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "Storage zones and storage units are the lowest level of material movement equipment typically scheduled by the Level 4 and Level 3 functions for discrete, batch and continuous manufacturing processes. A storage zone is a type of work center and a storage unit is a type of work unit that is organized as elements within an area. These are the lower-level elements of an equipment hierarchy used in material storage and movement activities. "@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkCenter;1"^^xsd:anyURI ] ;
    ns2:title "Storage zone"@en .

<dtmi:digitaltwins:isa95:TestResult;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.389218+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.389227+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The results from the test evaluation of property measurement of the testable object property of the testable object per the test specifications shall be presented as test results. A test result reports the measured results and evaluation of test specification criteria from a test for a specific person, piece of equipment, physical asset, material lot or material sublot"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the test result" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The child test result(s) of this test result" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfResults" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestResult;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The tested object recorded by this test result" ;
            ns5:displayName "Records test results for" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:recordsTestResultsFor" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ;
            ns7:comment "Mandatory. Must not be 'empty'" ],
        [ a ns5:Relationship ;
            ns5:description "The measurement obtained for each testable object property" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfMeasurements" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PropertyMeasurement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations test requirement object applied to execute the test and generate the test result" ;
            ns5:displayName "Generated in context of" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:generatedInContextOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsTestRequirement;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "pass" ;
                    ns2:title "Pass"@en ],
                [ ns1:const "fail" ;
                    ns2:title "Fail"@en ],
                [ ns1:const "warn" ;
                    ns2:title "Warn"@en ],
                [ ns6:comment "See additional property 'otherEvaluatedCriterionResult'" ;
                    ns1:const "other" ;
                    ns2:title "Other"@en ] ;
            ns2:description "Result obtained from evaluation of the associated test specification criteria."@en ;
            ns2:name "evaluatedCriterionResult" ;
            ns2:title "Evaluated criterion result"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "Date of the expiration of the test result criteria"@en ;
            ns2:name "expiration" ;
            ns2:title "Expiration"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Not part of the Standard. But makes 'evaluatedCriterionResult' property value list extensible"@en ;
            ns2:name "otherEvaluatedCriterionResult" ;
            ns2:title "Other evaluated criterion result"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "Date and time of evaluation of the test result"@en ;
            ns2:name "evaluationDate" ;
            ns2:title "Evaluation date"@en ] ;
    ns2:title "Test result"@en .

<dtmi:digitaltwins:isa95:TestSpecification;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.406325+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.406343+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The test specification details the test specification criteria and the tested evaluated property(s) required for a testable object to match the quality or performance requirements of the business or particular customers"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The child test specifications of this test specification" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The ID of the testable object tested by this test specification" ;
            ns5:displayName "Specifies test for" ;
            ns3:hasRelationType "dtdl:specifiesTestForObject" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The test specification criteria which is to be applied to determine the test outcome upon evaluation of the test specification" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfCriteria" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestSpecificationCriteria;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations test requirement ID(s) evaluated by this test specification" ;
            ns5:displayName "Specifies test for" ;
            ns3:hasRelationType "dtdl:specifiesTestForOperations" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsTestRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The evaluated property(s) measured and evaluated by this test specification" ;
            ns5:displayName "Evaluates" ;
            ns3:hasRelationType "dtdl:evaluates" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EvaluatedProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The test specification property values of this test specification" ;
            ns5:displayName "Has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestSpecificationProperty;1"^^xsd:anyURI ],
        [ ns5:description "A description of the test specification" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Sample size required to perform the test"@en ;
            ns2:name "testSampleSize" ;
            ns2:title "Test sample size"@en ],
        [ a ns1:StringSchema ;
            ns2:description "An identification of the version of the test specification"@en ;
            ns2:name "version" ;
            ns2:title "Version"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The duration of operational activity required between samples"@en ;
            ns2:name "recurrenceTimeInterval" ;
            ns2:title "Recurrence time interval"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The amount of operations activity required between samples"@en ;
            ns2:name "recurrenceQuantity" ;
            ns2:title "Recurrence quantity"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time on which the test specification was published or generated"@en ;
            ns2:name "publishedDate" ;
            ns2:title "Published date"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The effective end date and time for use of the test specification or set of test specifications"@en ;
            ns2:name "effectiveEndDate" ;
            ns2:title "Effective end date"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The effective start date and time for use of the test specification or set of test specifications"@en ;
            ns2:name "effectiveStartDate" ;
            ns2:title "Effective start date"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "yes" ;
                    ns2:description "physical samples are required"@en ;
                    ns2:title "Yes"@en ],
                [ ns1:const "no" ;
                    ns2:description "physical samples are not required"@en ;
                    ns2:title "No"@en ] ;
            ns2:description "Defines whether physical sampling is required to perform the test"@en ;
            ns2:name "physicalSample" ;
            ns2:title "Physical sample"@en ] ;
    ns2:title "Test specification"@en .

<dtmi:digitaltwins:isa95:TestSpecificationCriteria;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.387618+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.387626+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The test specification criteria object defines the set of criterion to evaluate and the test result to be reported when a testable object satisfies those criteria."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This test specification criteria used to evaluate the evaluated property of a testable object property" ;
            ns5:displayName "References" ;
            ns3:hasRelationType "dtdl:references" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EvaluatedProperty;1"^^xsd:anyURI ],
        [ ns5:description "Description of the test specification criteria" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "See additional property 'otherResult'" ;
                    ns1:const "other" ;
                    ns2:title "Other"@en ],
                [ ns1:const "pass" ;
                    ns2:title "Pass"@en ],
                [ ns1:const "fail" ;
                    ns2:title "Fail"@en ],
                [ ns1:const "warm" ;
                    ns2:title "Warn"@en ] ;
            ns2:description "The value to be given to the result of the test if the test specification criteria expression is evaluated as true"@en ;
            ns2:name "result" ;
            ns2:title "Result"@en ],
        [ a xsd:int,
                ns1:IntegerSchema ;
            ns2:description "Specifies the sequence of evaluation of test specification criteria. The sequence shall be executed lowest first. Duplicate sequence values shall be executed in parallel with worst case result reported if both criteria are evaluated as true"@en ;
            ns2:name "sequence" ;
            ns2:title "Sequence"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Not part of the Standard. But makes 'result' property value list extensible"@en ;
            ns2:name "otherResult" ;
            ns2:title "Other result"@en ],
        [ a ns1:StringSchema ;
            ns2:description "An expression of the test specification criteria to be evaluated. If the expression is empty, then the test specification criteria represents the else criterion"@en ;
            ns2:name "expression" ;
            ns2:title "Expression"@en ] ;
    ns2:title "Test specification criteria"@en .

<dtmi:digitaltwins:isa95:TestSpecificationProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.384403+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.384407+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The test specification property object defines properties of the test specification. These properties are not the characteristics to be tested"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The child test specification property(s) of this test specification property" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestSpecificationProperty;1"^^xsd:anyURI ] ;
    ns2:title "Test specification property"@en .

<dtmi:digitaltwins:isa95:TestableObject;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.390225+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.390230+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The testable object and testable object property are represented as abstract interface objects to simplify the operations test model diagram. The interface objects represent the objects that are able to be tested by a test specification(s)"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The test specification(s) used to evaluate this testable object." ;
            ns5:displayName "Specifies" ;
            ns3:hasRelationType "dtdl:specifies" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The testable object property values of this testable object" ;
            ns5:displayName "Has values of" ;
            ns3:hasRelationType "dtdl:hasTestableObjectPropertyValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ] ;
    ns2:title "Testable object"@en .

<dtmi:digitaltwins:isa95:TestableObjectProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.388135+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.388136+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The testable object and testable object property are represented as abstract interface objects to simplify the operations test model diagram. The interface objects represent the objects that are able to be tested by a test specification(s)"@en ;
    ns2:title "Testable object property"@en .

<dtmi:digitaltwins:isa95:ToResourceReference;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.558142+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.558146+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A 'to' reference to a resource shall be defined as a to resource reference."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the [resource] model as explained in Clause 3.3.8." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToResource" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the [resource] model as explained in Clause 3.3.8." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToResourceClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The to resource reference property(s) defines in part this to resource reference property" ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ToResourceReferenceProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "physical asset" ],
                [ ns1:const "work master" ],
                [ ns1:const "material definition" ],
                [ ns1:const "equipment class" ],
                [ ns1:const "material lot" ],
                [ ns1:const "operation definition" ],
                [ ns1:const "operational location" ],
                [ ns1:const "physical asset class" ],
                [ ns1:const "process segment" ],
                [ ns1:const "equipment" ],
                [ ns1:const "person" ],
                [ ns1:const "personnel class" ],
                [ ns1:const "test result" ],
                [ ns1:const "operations segment" ],
                [ ns1:const "material class" ],
                [ ns1:const "material sublot" ],
                [ ns1:const "test specification" ] ;
            ns2:description "The type of the resource. "@en ;
            ns2:name "resourceType" ;
            ns2:title "resourceType"@en ] ;
    ns2:title "To resource reference"@en .

<dtmi:digitaltwins:isa95:ToResourceReferenceProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.561365+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.561367+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A 'to' reference to a resource shall be defined as a to resource reference."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the [resource] model as explained in Clause 3.3.8." ;
            ns5:displayName "Maps To" ;
            ns3:hasRelationType "dtdl:mapsToClassProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceClassProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested 'to' resource reference properties of this 'to' resource reference property." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ToResourceReferenceProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the [resource] model as explained in Clause 3.3.8." ;
            ns5:displayName "Maps To" ;
            ns3:hasRelationType "dtdl:mapsToProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ] ;
    ns2:title "To resource reference property"@en .

<dtmi:digitaltwins:isa95:Unit;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.230724+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.230725+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "Units have well-defined processing capabilities and throughput capacities and these are used for Level 3 functions. T"@en ;
