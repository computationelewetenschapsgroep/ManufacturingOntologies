        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources used in the parent segment"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
