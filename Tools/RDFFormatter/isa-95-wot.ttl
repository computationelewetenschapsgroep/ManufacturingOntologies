    ns2:description "Specific properties that are required for material segment specifications shall be presented as material segment specification properties"@en ;
    ns2:hasLink [ ns5:description "Contains additional information and descriptions of the property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the material model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToDefinitionProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialDefinitionProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material segment specification property(s) of this material segment specification property" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSegmentSpecificationProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the material model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToLotProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialLotProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the material model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToClassProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialClassProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the material resource required for the parent segment"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ] ;
    ns2:title "Material specification property"@en .

<dtmi:digitaltwins:isa95:MaterialSublot;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.480898+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.480914+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Each separately identifiable quantity of the same material lot shall be presented as a material sublot. A material lot may be stored in separately identifiable quantities. All material sublots are part of the same material lot, so they have the material lot’s property values. A material sublot may be just a single item"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material lot property(s) of this material sublot." ;
            ns5:displayName "Has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialLotProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition" ],
        [ a ns5:Relationship ;
            ns5:description "The material sublot occurrences that are constructed based on this material sublot. The material sublot properties map to a corresponding material lot property" ;
            ns5:displayName "Is Assembled from" ;
            ns3:hasRelationType "dtdl:isAssembledFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSublot;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this material sublot as the whole." ;
            ns5:displayName "Is assembled from" ;
            ns3:hasRelationType "dtdl:isAssembledFromLot" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialLot;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Aggregation" ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to storage location." ;
            ns5:displayName "fits storage location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:storageLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "This material sublot is part of the related object as the whole" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSublot;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition" ],
        [ ns5:description "Additional information about the material definition" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies the storage location of the material sublot."@en ;
            ns2:name "storageLocation" ;
            ns2:title "Storage location"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "transient" ;
                    ns2:description "a temporary assembly using during production, such as a pallet of different materials or a batch kit"@en ],
                [ ns1:const "permanent" ;
                    ns2:description "an assembly that is not intended to be split during the production process"@en ] ;
            ns2:description "Defines the type of the relationships"@en ;
            ns2:name "assemblyRelationship" ;
            ns2:title "Assembly relationship"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Status of the material sublot in manufacturing operations. Values defined by implementation"@en ;
            ns2:name "status" ;
            ns2:title "Status"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Mandatory where a storage location is specified" ;
            ns1:oneOf [ ns6:comment "storage location attribute contains a description of the storage location, such as a street address" ;
                    ns1:const "description" ;
                    ns2:title "Description"@en ],
                [ ns6:comment "storage location attribute references an operational location" ;
                    ns1:const "operationalLocation" ;
                    ns2:title "Operational Location"@en ],
                [ ns6:comment "storage location attribute references an equipment object" ;
                    ns1:const "equipment" ;
                    ns2:title "Operational Location"@en ],
                [ ns6:comment " storage location attribute references a physical asset" ;
                    ns1:const "physicalAsset" ;
                    ns2:title "Physical Asset"@en ] ;
            ns2:description "Indicates whether the storage location attribute refers to anoperational location, equipmentor physical asset object, or contains a description of the storage location."@en ;
            ns2:name "storageLocationType" ;
            ns2:title "Storage location type"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "physical" ;
                    ns2:description "the components of the assembly are physically connected or in the same area"@en ],
                [ ns1:const "logical" ;
                    ns2:description "the components of the assembly are not necessarily physically connected or in the same area"@en ] ;
            ns2:description "Defines the type of the assembly"@en ;
            ns2:name "assemblyType" ;
            ns2:title "Assembly type"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "The quantity of the material sublot. "@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "restricted" ;
                    ns2:description "a material lot is not permitted for normal use due to a restriction condition"@en ;
                    ns2:title "Restricted"@en ],
                [ ns1:const "unrestricted" ;
                    ns2:description "material lot is permitted for normal use without restriction"@en ;
                    ns2:title "Unrestricted"@en ],
                [ ns1:const "planned" ;
                    ns2:description "a material lot that does not yet physically exist, is assigned to an operations request (segment requirement) or work request (Part 4 object) or job order (Part 4 object)"@en ;
                    ns2:title "Planned"@en ],
                [ ns1:const "inProcess" ;
                    ns2:description "the material lot is in the process of being worked on"@en ;
                    ns2:title "in Process"@en ],
                [ ns1:const "closed" ;
                    ns2:description "material lot has been reconciled as completely consumed, sold or disposed of"@en ;
                    ns2:title "Closed"@en ] ;
            ns2:description "Planning and logistics disposition of a material sublot or assembly of material lots. "@en ;
            ns2:name "disposition" ;
            ns2:title "Disposition"@en ] ;
    ns2:title "Material sublot"@en .

<dtmi:digitaltwins:isa95:OperationalLocation;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.499213+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.499218+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A logical or physical location where a material lot, material sublot, equipment, physical asset or person is located or expected to be located shall be presented as an operational location. Operational locations may be made up of other operational locations."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The operational location property(s) of this operational location." ;
            ns5:displayName "Has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocationProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions of the operational location." ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operational location class(s) to which this operational location belongs" ;
            ns5:displayName "Defined by" ;
            ns3:hasRelationType "dtdl:definedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocationClass;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Association" ],
        [ a ns5:Relationship ;
            ns5:description "The child operational location(s) contained within this operational location." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Operational location"@en .

<dtmi:digitaltwins:isa95:OperationalLocationClass;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.505358+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.505371+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A representation of a grouping of operational locations with similar characteristics for a definite purpose such as manufacturing operations definition, scheduling, capability and performance shall be presented as an operational location class. Any operational location may be a member of zero or more operational location classes."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The operational location class property(s) of this operational location class" ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocationClassProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This operational location class(s) include properties of the operational location class." ;
            ns5:displayName "Includes properties of" ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocationClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent operational location class is whole of the child operational location class(s) as the part" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocationClass;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the operational location class" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Operational location class"@en .

<dtmi:digitaltwins:isa95:OperationalLocationClassProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.499991+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.499997+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of an operational location class shall be defined as operational location class property(s). An operational location class property may contain nested operational location class property(s). An operational location class property may have zero or more operational location property(s) mapping to it."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the operational location class property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The child operational location class property(s) of this operational location class property." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocationClassProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "classType" ;
                    ns2:description "The property value is defined for the class and there is no value associated with an instance"@en ;
                    ns2:title "Class Type"@en ],
                [ ns1:const "defaultType" ;
                    ns2:description "The property value is defined for the class as the default instance value, but individual instances of the class may redefine specific values."@en ;
                    ns2:title "Default Type"@en ],
                [ ns1:const "instanceType" ;
                    ns2:description "the property value of the class is undefined"@en ;
                    ns2:title "Instance Type"@en ] ;
            ns2:description "Defines the type of the property."@en ;
            ns2:name "propertyType" ;
            ns2:title "Property type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ] ;
    ns2:title "Operational location class property"@en .

<dtmi:digitaltwins:isa95:OperationalLocationProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.500574+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.500578+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of operational locations shall be presented as operational location properties. Anoperational location shall have zero or more operational location properties. These specify the current property values of the operational location for the associated operational location class property. Operational location properties may include a unit of measure."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The child operational location property(s) of this operational location property." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocationProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition hierarchy" ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operational location class property to which this operational location class property maps." ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocationClassProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Dependency" ] ;
    ns2:title "Operational location property"@en .

<dtmi:digitaltwins:isa95:OperationsCapability;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.431862+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.431881+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A collection of personnel capabilities, equipment capabilities, physical asset capabilities, material capabilities, process segment capabilities, and operations segment capabilities for a given slice of time (past, current, or future), shall be presented as an operations capability."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The equipment capability(s) related to this operations capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The process segment capability(s) related to this operations capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfProcess" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegmentCapability;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The personnel capability(s) related to this operations capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material capability(s) related to this operations capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations segment capability(s) related to this operations capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfOperations" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegmentCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset capability(s) related to this operations capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetCapability;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Defines the reason for the capability type."@en ;
            ns2:name "reason" ;
            ns2:title "Reason"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time used for operations capability was published or generated."@en ;
            ns2:name "publishedDate" ;
            ns2:title "Published Date"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "capacity that is not attainable for future productive use given the equipment condition, equipment utilization, personnel availability or material availability." ;
                    ns1:const "unattainable" ],
                [ ns6:comment "a historical value that defines the portion of the capacity with acceptable quality." ;
                    ns1:const "used" ],
                [ ns6:comment "the sum of used and unused capability or the sum of available, unattainable and committed capability." ;
                    ns1:const "total" ],
                [ ns6:comment " a historical value that defines the portion of the capacity that was not used or had unacceptable quality." ;
                    ns1:const "unused" ],
                [ ns6:comment "capacity that is available for additional future productive use." ;
                    ns1:const "available" ],
                [ ns6:comment ": capacity that is committed for future productive use." ;
                    ns1:const "committed" ] ;
            ns2:description "Defines the type of capability. "@en ;
            ns2:name "capabilityType" ;
            ns2:title "Capability type"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The capability end time of this segment response."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Measure of the confidence of the ability to obtain the capacity value."@en ;
            ns2:name "confidenceFactor" ;
            ns2:title "Confidence Factor"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The capability start time of this segment response."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ] ;
    ns2:title "Operations capability"@en .

<dtmi:digitaltwins:isa95:OperationsDefinition;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.411734+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.411746+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The resources required to perform a specified operation shall be presented as an operations definition"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The detailed information needed to quantify a specific operation definition." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This operations definition class(s) include properties of the operations definition class" ;
            ns5:displayName "Includes properties of" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Identification of the operations material bill associated with this operations definition." ;
            ns5:displayName "Has associated" ;
            ns3:hasRelationType "dtdl:hasAssociated" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsMaterialBill;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "instance" ;
                    ns2:description "a operations defintion that may be directly scheduled and tracked"@en ],
                [ ns1:const "pattern" ;
                    ns2:description "an operations defintion used as a template for other operations defintions"@en ] ;
            ns2:description "Defines the type of the process segment"@en ;
            ns2:name "definitionType" ;
            ns2:title "Definition type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "An identification of the version of the operations definition"@en ;
            ns2:name "version" ;
            ns2:title "Version"@en ] ;
    ns2:title "Operations definition"@en .

<dtmi:digitaltwins:isa95:OperationsEvent;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.524256+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.524266+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Large numbers of real-world events occur in any given manufacturing system. Only some real-world events are associated with manufacturing operations management activities and functions. The subset of those real-world events that require notification of process context specific information exchanges of this standard shall be defined as operations events. Operations events may be generated by any Level 4 or Level 3 function or activity"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The operations event definition that defines the structure and generic context of the operation event message" ;
            ns5:displayName "Defined by" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:definedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventDefinition;1"^^xsd:anyURI ;
            ns7:comment "Mandatory - Cardinality 1" ],
        [ a ns5:Relationship ;
            ns5:description "This operations event is part of the related object as the whole. The associated events related to this operations event message. The reference is an ID with any additional attributes required" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEvent;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations event records related to this operations event" ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventRecord;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations event property values of this operations event" ;
            ns5:displayName "Has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventProperty;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions of the operations event" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Priority of the operations event that Is a guide to the relative level of importance of an operations event"@en ;
            ns2:name "priority" ;
            ns2:title "priority"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "alarm" ;
                    ns2:title "Alarm"@en ],
                [ ns1:const "alert" ;
                    ns2:title "Alert"@en ],
                [ ns1:const "event" ;
                    ns2:title "Event"@en ] ;
            ns2:description "The type of Level 3 operations event"@en ;
            ns2:name "operationsEventType" ;
            ns2:title "Operations event type"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Defined values from Part 1 Functional Model are" ;
            ns1:oneOf [ ns1:const "operationsScheduling" ;
                    ns2:title "Operations scheduling"@en ],
                [ ns1:const "engineering" ;
                    ns2:title "Engineering"@en ],
                [ ns1:const "marketingAndSales" ;
                    ns2:title "Marketing and sales"@en ],
                [ ns1:const "rAndD" ;
                    ns2:title "R&D"@en ],
                [ ns1:const "productInventoryControl" ;
                    ns2:title "Product inventory control"@en ],
                [ ns1:const "productCostAccounting" ;
                    ns2:title "Product cost accounting"@en ],
                [ ns1:const "qualityAssurance" ;
                    ns2:title "Quality assurance"@en ],
                [ ns1:const "productionControl" ;
                    ns2:title "Production control"@en ],
                [ ns1:const "maintenanceManagement" ;
                    ns2:title "Maintenance management"@en ],
                [ ns1:const "productShippingAdministration" ;
                    ns2:title "Product shipping administration"@en ],
                [ ns1:const "procurement" ;
                    ns2:title "Procurement"@en ],
                [ ns1:const "materialAndEnergyControl" ;
                    ns2:title "Material and energy control"@en ],
                [ ns1:const "orderProcessing" ;
                    ns2:title "Order processing"@en ] ;
            ns2:description "Defines the enterprise function of the operations event publisher"@en ;
            ns2:name "enterpriseFunction" ;
            ns2:title "Enterprise function"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Defined values from Part 3 MOM Activity Model are" ;
            ns1:oneOf [ ns1:const "definitionManagement" ;
                    ns2:title "Definition management"@en ],
                [ ns1:const "detailedScheduling" ;
                    ns2:title "Detailed scheduling"@en ],
                [ ns1:const "tracking" ;
                    ns2:title "Tracking"@en ],
                [ ns1:const "resourceManagement" ;
                    ns2:title "Resource management"@en ],
                [ ns1:const "dispatching" ;
                    ns2:title "Dispatching"@en ],
                [ ns1:const "performanceAnalysis" ;
                    ns2:title "Performance analysis"@en ],
                [ ns1:const "executionManagement" ;
                    ns2:title "Execution management"@en ],
                [ ns1:const "dataCollection" ;
                    ns2:title "Data collection"@en ] ;
            ns2:description "Defines the MOM function of the operations event publisher"@en ;
            ns2:name "momFunction" ;
            ns2:title "MOM function"@en ],
        [ a ns1:StringSchema ;
            ns2:description "General grouping associated with an operations event definition"@en ;
            ns2:name "category" ;
            ns2:title "Category"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The activity, function, task or phase that generated the operations event"@en ;
            ns2:name "source" ;
            ns2:title "Source"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time the real-world event occurred"@en ;
            ns2:name "effectiveTimestamp" ;
            ns2:title "Effective timestamp"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The time the operations event was recorded / transacted by the publisher"@en ;
            ns2:name "recordTimestamp" ;
            ns2:title "Record timestamp"@en ],
        [ a ns1:IntegerSchema ;
            ns1:oneOf [ ns1:const 4 ;
                    ns2:title "Level 4"@en ],
                [ ns1:const 3 ;
                    ns2:title "Level 3"@en ] ;
            ns2:description "Defines the domain level of the operations event publisher"@en ;
            ns2:name "operationsEventLevel" ;
            ns2:title "Operations event level"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute" ;
            ns1:oneOf [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns6:comment "Mixed can be used when the operations event does not refer to a specific operations activity or refers to several operation activities" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ] ;
            ns2:description "Describes the category of operation"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Operations event"@en .

<dtmi:digitaltwins:isa95:OperationsEventClass;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.510466+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.510474+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "An operations event class is a representation of groupings of operations event definitions"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This operations event class(s) include properties of the operations event class" ;
            ns5:displayName "Includes properties of" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested operations event class(s) makes up part of this operations event class as the whole" ;
            ns5:displayName "Is assembled from" ;
            ns3:hasRelationType "dtdl:isAssembledFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations event class property(s) of this operations event class" ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventClassProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations event class record specification(s) related to this operations event class" ;
            ns5:displayName "Has record specification of" ;
            ns3:hasRelationType "dtdl:hasRecordSpecificationOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventClassRecordSpecification;1"^^xsd:anyURI ],
        [ ns5:description "Additional information and description about the operations event class" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:comment "Defined value are - sealed: no entry can use this entry as its parent; - (No entry): no entry allows any entry to represent this entry as its parent /ancestor. NOTE 1 Extension can contain a set of entries of other operations event classes who represent this entry in their parent" ;
            ns2:description "Defines constraints on the inclusion of the respective operations event class in a hierarchy"@en ;
            ns2:name "extension" ;
            ns2:title "Extension"@en ] ;
    ns2:title "Operations event class"@en .

<dtmi:digitaltwins:isa95:OperationsEventClassProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.520447+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.520462+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of an operations event class shall be listed as operations event class properties. An operations event class shall be further characterized through zero or more operations event class properties. Operations event class properties may contain nested operations event class properties"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The child operations event classes contained within this operations event class" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventClassProperty;1"^^xsd:anyURI ],
        [ ns5:description "Additional information and description about the operations event class property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "defaultType" ;
                    ns2:description "The property value is defined for the class as the default instance value, but individual instances of the class may redefine specific values."@en ;
                    ns2:title "Default Type"@en ],
                [ ns1:const "instanceType" ;
                    ns2:description "the property value of the class is undefined"@en ;
                    ns2:title "Instance Type"@en ],
                [ ns1:const "classType" ;
                    ns2:description "The property value is defined for the class and there is no value associated with an instance"@en ;
                    ns2:title "Class Type"@en ] ;
            ns2:description "Defines the type of the property."@en ;
            ns2:name "propertyType" ;
            ns2:title "Property type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ] ;
    ns2:title "Operations event class property"@en .

<dtmi:digitaltwins:isa95:OperationsEventClassRecordSpecification;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.506464+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.506481+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Operations event classes define common structures of operations event definitions using operations event class record specifications. Operations event definitions as members of an operations event class that contain operations event class record specifications must support the record specification entries indicated in the operations event class. The structure and semantics of the operations event class record specification is the same as the operations event definition record specification"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent operations event definition record specification is whole of the child operations event definition record specification(s) as the part" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventDefinitionRecordSpecification;1"^^xsd:anyURI ] ;
    ns2:title "Operations event class record specification"@en .

<dtmi:digitaltwins:isa95:OperationsEventDefinition;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.515992+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.516018+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Definition and structure of operations event occurrences shall be shown as an operations event definition. The operations event definition of an operations event is identified by the definition ID attribute in the operations event occurrence. Those constructing or interpreting an operations event obtain and validate the structure and definition from the operations event definition"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The nested operations event definition(s) makes up part of this operations event definition as the whole" ;
            ns5:displayName "Is assembled from" ;
            ns3:hasRelationType "dtdl:isAssembledFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations event definition property(s) specifies this operations event definition" ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventDefinitionProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Operations event class(s) supported by this operations event definition. The operations event definition supports the operations event class property(s) and operations event class record specification associated with the operations event class" ;
            ns5:displayName "Is a member of" ;
            ns3:hasRelationType "dtdl:isAMemberOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations event definition record specification(s) related to this operations event definition" ;
            ns5:displayName "Has record specifications of" ;
            ns3:hasRelationType "dtdl:hasRecordSpecificationsOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventDefinitionRecordSpecification;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions of the operations event definition" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The operations event definition IDs of any expected subsequent notification"@en ;
            ns2:name "acknowledgment" ;
            ns2:title "Acknowledgment"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "alert" ;
                    ns2:title "Alert"@en ],
                [ ns1:const "Alarm" ;
                    ns2:title "Alarm"@en ],
                [ ns1:const "event" ;
                    ns2:title "Event"@en ] ;
            ns2:description "The type of Level 3 operations event"@en ;
            ns2:name "operationsEventType" ;
            ns2:title "Operations event type"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Production examples: {1,2,3}; Maintenance examples: {Low, Medium, High}" ;
            ns2:description "List of the priorities that act as a guide to the relative level of importance of an operations event"@en ;
            ns2:name "priority" ;
            ns2:title "Priority"@en ],
        [ a ns1:IntegerSchema ;
            ns1:oneOf [ ns1:const 4 ;
                    ns2:title "Level 4"@en ],
                [ ns1:const 3 ;
                    ns2:title "Level 3"@en ] ;
            ns2:description "Defines the domain level of the operations event publisher"@en ;
            ns2:name "operationsEventLevel" ;
            ns2:title "Operations event level"@en ],
        [ a ns1:StringSchema ;
            ns2:description "General grouping associated with an operations event definition"@en ;
            ns2:name "category" ;
            ns2:title "Category"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The activity that generated the operations event"@en ;
            ns2:name "source" ;
            ns2:title "Source"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Defined values from Part 1 Functional Model are" ;
            ns1:oneOf [ ns1:const "qualityAssurance" ;
                    ns2:title "Quality assurance"@en ],
                [ ns1:const "productionControl" ;
                    ns2:title "Production control"@en ],
                [ ns1:const "marketingAndSales" ;
                    ns2:title "Marketing and sales"@en ],
                [ ns1:const "materialAndEnergyControl" ;
                    ns2:title "Material and energy control"@en ],
                [ ns1:const "productShippingAdministration" ;
                    ns2:title "Product shipping administration"@en ],
                [ ns1:const "maintenanceManagement" ;
                    ns2:title "Maintenance management"@en ],
                [ ns1:const "productInventoryControl" ;
                    ns2:title "Product inventory control"@en ],
                [ ns1:const "operationsScheduling" ;
                    ns2:title "Operations scheduling"@en ],
                [ ns1:const "orderProcessing" ;
                    ns2:title "Order processing"@en ],
                [ ns1:const "engineering" ;
                    ns2:title "Engineering"@en ],
                [ ns1:const "procurement" ;
                    ns2:title "Procurement"@en ],
                [ ns1:const "productCostAccounting" ;
                    ns2:title "Product cost accounting"@en ],
                [ ns1:const "rAndD" ;
                    ns2:title "R&D"@en ] ;
            ns2:description "Defines the enterprise function of the operations event publisher"@en ;
            ns2:name "enterpriseFunction" ;
            ns2:title "Enterprise function"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scope defines the scope of the equipment class, such as the site or area where it is defined."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Defined values from Part 3 MOM Activity Model are" ;
            ns1:oneOf [ ns1:const "definitionManagement" ;
                    ns2:title "Definition management"@en ],
                [ ns1:const "executionManagement" ;
                    ns2:title "Execution management"@en ],
                [ ns1:const "performanceAnalysis" ;
                    ns2:title "Performance analysis"@en ],
                [ ns1:const "dataCollection" ;
                    ns2:title "Data collection"@en ],
                [ ns1:const "dispatching" ;
                    ns2:title "Dispatching"@en ],
                [ ns1:const "tracking" ;
                    ns2:title "Tracking"@en ],
                [ ns1:const "detailedScheduling" ;
                    ns2:title "Detailed scheduling"@en ],
                [ ns1:const "resourceManagement" ;
                    ns2:title "Resource management"@en ] ;
            ns2:description "Defines the MOM function of the operations event publisher"@en ;
            ns2:name "momFunction" ;
            ns2:title "MOM function"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute" ;
            ns1:oneOf [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ] ;
            ns2:description "Describes the category of operation"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ] ;
    ns2:title "Operations event definition"@en .

<dtmi:digitaltwins:isa95:OperationsEventDefinitionProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.508807+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.508828+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of an operations event definition shall be defined as operations event definition properties. An operations event definition shall be further characterized through zero or more operations event definition properties. Operations event definition properties may contain nested operations event definition properties"@en ;
    ns2:hasLink [ ns5:description "Additional information and description about the operations event definition property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested operations event definition property(s) makes up part of this operations event definition property as the whole" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventDefinitionProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "If the operations event definition supports an operations event class, the operations event class property(s) are applied in the operations event definition property(s). This operations event definition property maps to the corresponding operations event class property" ;
            ns5:displayName "Maps to" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventClassProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "instanceType" ;
                    ns2:description "the property value of the class is undefined"@en ;
                    ns2:title "Instance Type"@en ],
                [ ns1:const "defaultType" ;
                    ns2:description "The property value is defined for the class as the default instance value, but individual instances of the class may redefine specific values."@en ;
                    ns2:title "Default Type"@en ],
                [ ns1:const "classType" ;
                    ns2:description "The property value is defined for the class and there is no value associated with an instance"@en ;
                    ns2:title "Class Type"@en ] ;
            ns2:description "Defines the type of the property."@en ;
            ns2:name "propertyType" ;
            ns2:title "Property type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ] ;
    ns2:title "Operations event definition property"@en .

<dtmi:digitaltwins:isa95:OperationsEventDefinitionRecordSpecification;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.509704+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.509715+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specification of the allowed content of operations event record shall be defined as the operations event definition record specification. Information object contents in an operations event vary depending on the process context of the operations event. The operations event definition record specification describes and specifies the information objects and associated actions that are allowed in the operations event occurrence. The publisher/sender shall follow this specification to construct the message"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "If the operations event supports an operations event class, the operations event class record specification(s) is applied in this operations event definition record specification. This operations event definition record specification maps to the corresponding operations event class record specification" ;
            ns5:displayName "Maps to" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventClassRecordSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent operations event definition record specification is whole of the child operations event definition record specification (s) as the part" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventDefinitionRecordSpecification;1"^^xsd:anyURI ] ;
    ns2:title "Operations event definition record specification"@en .

<dtmi:digitaltwins:isa95:OperationsEventProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.519255+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.519276+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties of an operations event shall be defined as operations event properties. An operations event shall be further characterized through zero or more operations event properties. Operations event properties may contain nested operations event properties"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the operations event property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested operations event property(s) makes up part of this operations event property as the whole" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations event(s) supports the operations definition. The operations event definition property(s) is applied in this operations event property(s). This operations event property maps to the corresponding operations event definition property. If the same ID exists in an operations event definition property, the attributes of the property will be the same" ;
            ns5:displayName "Maps to" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventDefinitionProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "classType" ;
                    ns2:description "The property value is defined for the class and there is no value associated with an instance"@en ;
                    ns2:title "Class Type"@en ],
                [ ns1:const "defaultType" ;
                    ns2:description "The property value is defined for the class as the default instance value, but individual instances of the class may redefine specific values."@en ;
                    ns2:title "Default Type"@en ],
                [ ns1:const "instanceType" ;
                    ns2:description "the property value of the class is undefined"@en ;
                    ns2:title "Instance Type"@en ] ;
            ns2:description "Defines the type of the property."@en ;
            ns2:name "propertyType" ;
            ns2:title "Property type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ] ;
    ns2:title "Operations event property"@en .

<dtmi:digitaltwins:isa95:OperationsEventRecord;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.521449+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.521467+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The bundle of operations event record entry objects that are pertinent to the real-world MOM event shall be defined as an operations event record"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The operations event definition record specification defines the allowed information objects contained within this operations event record. The specified actions must match the action attribute in this operations event record entry" ;
            ns5:displayName "Specified by" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:specifiedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventDefinitionRecordSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent operations event record is whole of the child operations event record(s) as the part" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventRecord;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and description of the operations event record" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This operations record acts as a container for operations record entry(s) with common action attribute applied" ;
            ns5:displayName "Records action on" ;
            ns3:hasRelationType "dtdl:recordsActionOn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventRecordEntry;1"^^xsd:anyURI ;
            ns7:comment "Multiplicity: 1" ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "changed" ],
                [ ns1:const "added" ],
                [ ns1:const "deleted" ],
                [ ns1:const "observed" ] ;
            ns2:description "The action performed on the operations event record entry within the operations event record"@en ;
            ns2:name "action" ;
            ns2:title "Action"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time the publisher recorded/transacted the action. The record timestamp attribute explicitly states the time that the publisher/sender took the reported action. If no entry is provided, the record timestamp is the record timestamp represented in the operations event"@en ;
            ns2:name "recordTimestamp" ;
            ns2:title "Record timestamp"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time for which the operations event record and its action was/is effective. The effective timestamp attribute explicitly states the time of the real-world event.If no entry is provided, the effective timestamp is the effective timestamp represented in the operations event"@en ;
            ns2:name "effectiveTimestamp" ;
            ns2:title "Effective timestamp"@en ] ;
    ns2:title "Operations event record"@en .

<dtmi:digitaltwins:isa95:OperationsEventRecordEntry;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.518183+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.518194+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The operations event record entry object shall be a single information object and any third-party manufacturing operations message profile within an operations event record. There shall be one or more operations event record entry objects in an operations event record. The relationships and their roles in an operations event record entry are defined in the operations record specification"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "An embedded information object. If data is referenced in this operations event record entry, the attribute is not used. The format of the information object is specified in the operations event record specification" ;
            ns5:displayName "Corresponds to an entry in" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:correspondsToAnEntryIn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent operations event record entry is whole of the child operations event record entry(s) as the part" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsEventRecordEntry;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and description of the operations event record" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The reference to external data (information object) which is stored external to this operations event record entry. If data is embedded in this operations event record entry, the attribute is not used. The format of the reference is specified in the operations event record specification" ;
            ns5:displayName "Corresponds to an entry in" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:correspondsToAnExternalEntryIn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time the publisher recorded / transacted the action. If no entry is provided, the record timestamp is the record timestamp attribute in the operations event record"@en ;
            ns2:name "recordTimestamp" ;
            ns2:title "Record timestamp"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the type of information object type that an operations event record entry is based upon. The allowed information object types are defined in the operations event record specification"@en ;
            ns2:name "informationObjectType" ;
            ns2:title "Information object type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "An embedded information object. If data is referenced in this operations event record entry, the attribute is not used. The format of the information object is specified in this operations record specification"@en ;
            ns2:name "informationObject" ;
            ns2:title "Information object"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time that the operations event record entry was/is effective. If no effective timestamp is provided with operations event record entry, the effective timestamp is represented by the effective timestamp attribute in the operations event record"@en ;
            ns2:name "effectiveTimestamp" ;
            ns2:title "Effective timestamp"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The reference to external data (information object) which is stored external to this operations event record entry. If data is embedded in this operations event record entry, the attribute is not used. The format of the reference is specified in this operations event record specification"@en ;
            ns2:name "informationObjectID" ;
            ns2:title "Information object ID"@en ] ;
    ns2:title "Operations event record entry"@en .

<dtmi:digitaltwins:isa95:OperationsMaterialBill;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.415728+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.415729+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The collection of all material used in the operation, independent of the process segment the material is used in, shall be presented as operations material bills."@en ;
    ns2:hasLink [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The material bill items that are part of this operations material bill. " ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isACollectionOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsMaterialBillItem;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "mixed" ;
                    ns2:description "indicates that operations material bill items are both consumed and produced materials. "@en ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "produced" ;
                    ns2:description "indicates that operations material bill items are all produced materials. "@en ;
                    ns2:title "Produced"@en ],
                [ ns1:const "consumed" ;
                    ns2:description "indicates that operations material bill items are all consumed material."@en ;
                    ns2:title "Consumed"@en ] ;
            ns2:description "Defines the use of the material"@en ;
            ns2:name "useType" ;
            ns2:title "use type"@en ] ;
    ns2:title "Operations material bill"@en .

<dtmi:digitaltwins:isa95:OperationsMaterialBillItem;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.415209+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.415212+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The items that make up the complete operations material bill shall be presented as operations material bill items."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material specification(s) defines this specified operation material bill item(s)." ;
            ns5:displayName "Is Use Of" ;
            ns3:hasRelationType "dtdl:isUseOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSpecification;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The child operations material bill item(s) makes up part of this operations material bill item as the whole." ;
            ns5:displayName "Is Assembled From" ;
            ns3:hasRelationType "dtdl:isAssembledFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsMaterialBillItem;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies the associated material class or set of material classes."@en ;
            ns2:name "materialClass" ;
            ns2:title "Material Class"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "transient" ;
                    ns2:description "a temporary assembly using during production, such as a pallet of different materials or a batch kit"@en ],
                [ ns1:const "permanent" ;
                    ns2:description "an assembly that is not intended to be split during the production process"@en ] ;
            ns2:description "Defines the type of the relationships"@en ;
            ns2:name "assemblyRelationship" ;
            ns2:title "Assembly relationship"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the associated material definition or set of material."@en ;
            ns2:name "materialDefinition" ;
            ns2:title "Material Definition"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the personnel resource required for the parent process segment"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "logical" ;
                    ns2:description "the components of the assembly are not necessarily physically connected or in the same area"@en ],
                [ ns1:const "physical" ;
                    ns2:description "the components of the assembly are physically connected or in the same area"@en ] ;
            ns2:description "Defines the type of the assembly"@en ;
            ns2:name "assemblyType" ;
            ns2:title "Assembly type"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "mixed" ;
                    ns2:description "indicates that operations material bill items are both consumed and produced materials. "@en ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "produced" ;
                    ns2:description "indicates that operations material bill items are all produced materials. "@en ;
                    ns2:title "Produced"@en ],
                [ ns1:const "consumed" ;
                    ns2:description "indicates that operations material bill items are all consumed material."@en ;
                    ns2:title "consumed"@en ] ;
            ns2:description "Defines the use of the material"@en ;
            ns2:name "useType" ;
            ns2:title "use type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Operations material bill item"@en .

<dtmi:digitaltwins:isa95:OperationsPerformance;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.450882+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.450894+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The performance of the requested manufacturing requests shall be presented as an operations performance."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The operations responses that make up part of this operations performance as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsResponse;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "An identification of the associated operations schedule." ;
            ns5:displayName "References" ;
            ns3:hasRelationType "dtdl:references" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSchedule;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time of the associated operations performance."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time on which the operations performance was published or generated"@en ;
            ns2:name "publishedDate" ;
            ns2:title "Published date"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "held" ],
                [ ns1:const "suspended" ],
                [ ns1:const "completed" ],
                [ ns1:const "cancelled" ],
                [ ns1:const "forecast" ],
                [ ns1:const "running" ],
                [ ns1:const "waiting" ],
                [ ns1:const "ready" ],
                [ ns1:const "closed" ],
                [ ns1:const "released" ],
                [ ns1:const "aborted" ] ;
            ns2:description "Indicates the state of the operations performance."@en ;
            ns2:name "performanceState" ;
            ns2:title "Performance state"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time of the associated operations performance."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ] ;
            ns2:description "Describes the category of operation"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ] ;
    ns2:title "Operations performance"@en .

<dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.527199+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.527210+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The operations record entry template object shall be a single information object as an object defined in this part and Part 4 of this standard, and any third-party manufacturing operations message profile within an operations record template. There shall be one or more operations record entry template objects in an operations event record template"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "An embedded information object. If data is referenced in this operations record entry template, the attribute is not used. The format of the information object is specified in the operations record specification template" ;
            ns5:displayName "Corresponds to an entry in" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:correspondsToAnEntryIn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the operations record entry template" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent operations record entrytemplate is whole of the child operations record entry template(s) as the part" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The reference to external data (information object) which is stored external to this operations record entry template. If data is embedded in this operations record entry template, the attribute is not used. The format of the reference is specified in the operations record specification template" ;
            ns5:displayName "Corresponds to an entry in" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:correspondsToAnExternalEntryIn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The reference to external data (information object) which is stored external to this operations record entry template. If data is embedded in this operations record entry template, the attribute is not used. The format of the reference is specified in this operations record specification template"@en ;
            ns2:name "informationObjectID" ;
            ns2:title "Information object ID"@en ],
        [ a ns1:StringSchema ;
            ns2:description "An embedded information object. If data is referenced in this operations record entry template, the attribute is not used. The format of the information object is specified in this operations record specification template"@en ;
            ns2:name "informationObject" ;
            ns2:title "Information object"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time the publisher recorded / transacted the action. If no entry is provided, the record timestamp is the record timestamp attribute in the operations record template"@en ;
            ns2:name "recordTimestamp" ;
            ns2:title "Record timestamp"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time that the operations record entry template was/is effective. If no effective timestamp is provided with operations record entry template, the effective timestamp is represented by the effective timestamp attribute in the operations record template"@en ;
            ns2:name "effectiveTimestamp" ;
            ns2:title "Effective timestamp"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the type of information object type that an operations record entry template is based upon. The allowed information object types are defined in the operations record specification template"@en ;
            ns2:name "informationObjectType" ;
            ns2:title "Information object type"@en ] ;
    ns2:title "Operations record entry template"@en .

<dtmi:digitaltwins:isa95:OperationsRecordSpecificationTemplate;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.526078+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.526091+01:00"^^xsd:dateTime ;
    ns4:comment "Abstract - According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specification of the permitted content and form of objects in an operations record template shall be defined in an associated operations record specification template"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent operations record specification template is whole of the child operations record specification template(s) as the part" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsRecordSpecificationTemplate;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and description of the operations record specification template" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:comment "Samples: {Min: 1, Max: 1}, Min:1, Max: Unbounded}" ;
            ns2:description "The range of the information object(s) in operations record entry template allowed in the operations record template occurrence. If no limit is explicitly specified, the unbounded keyword is specified. If no multiplicity entry is specified, this is equivalent to no constraint. EXAMPLE 2 {Min: 0, Max: Unbounded}"@en ;
            ns2:name "informationObjectTypeMultiplicity" ;
            ns2:title "Information object type multiplicity"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Since DTDLv2 doesn't support array, use strings like [Equipment, Personnel] or [JobList]" ;
            ns2:description "Permitted set of information objects allowed in the operations record template occurrence. An operations record entry template contains the reference to the information object for operations record template. NOTE 1 An unconstrained set of values can be represented with the * entry"@en ;
            ns2:name "informationObjectType" ;
            ns2:title "Information object type"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Samples: {Min: 1, Max: 1}, Min:1, Max: Unbounded}" ;
            ns2:description "The range of actions allowed to be represented in the operations record template occurrence.If no limit is explicitly specified, the unbounded keyword is specified. If no multiplicity entry is specified, this is equivalent to no constraint. EXAMPLE 3 {Min: 0, Max: Unbounded}"@en ;
            ns2:name "ationMultiplicity" ;
            ns2:title "Action multiplicity"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "observed" ],
                [ ns1:const "deleted" ],
                [ ns1:const "changed" ],
                [ ns1:const "added" ] ;
            ns2:description "The permitted set of actions applied to the operations record entry template object in the operations record template by the publisher. Defined values for action are added, changed, deleted, and observed. If no action is specified, this is equivalent to all actions being allowed"@en ;
            ns2:name "action" ;
            ns2:title "Action"@en ] ;
    ns2:title "Operations record specification template"@en .

<dtmi:digitaltwins:isa95:OperationsRecordTemplate;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.525016+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.525026+01:00"^^xsd:dateTime ;
    ns4:comment "Abstract - According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The bundle of operations record entry template objects pertinent to a specified real-world manufacturing recording activity shall be defined as an operations record template"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "This parent operations record template is whole of the child operations record template(s) as the part" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsRecordTemplate;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This operations record template acts as a container for operations record entry template (s) applying a common action for each operations record template" ;
            ns5:displayName "Records action on" ;
            ns3:hasRelationType "dtdl:recordsActionOn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsRecordEntryTemplate;1"^^xsd:anyURI ;
            ns7:comment "Cardiniality is 1..*" ],
        [ ns5:description "Contains additional information and description of the operations record template" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations record specification template defines the information object(s) allowed to be contained within an operations record entry template in this operation record template. The specified action must match the value in the attribute, action, in this operations record template" ;
            ns5:displayName "Specified by" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:specifiedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsRecordSpecificationTemplate;1"^^xsd:anyURI ;
            ns7:comment "Mandatory" ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time the publisher recorded/transacted the action. Record timestamp explicitly states the time that the publisher took the action of the operations record template"@en ;
            ns2:name "recordTimestamp" ;
            ns2:title "Record timestamp"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time that the operations record entry template was/is effective as the time of the real-world event’s recording. If no effective timestamp is provided with operations record entry template, the effective timestamp is represented by the effective timestamp attribute in the operations record template"@en ;
            ns2:name "effectiveTimestamp" ;
            ns2:title "Effective timestamp"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "observed" ],
                [ ns1:const "added" ],
                [ ns1:const "deleted" ],
                [ ns1:const "changed" ] ;
            ns2:description "The action performed on the operations record entry template(s) within the operations record template. Defined values are added, changed, deleted and observed"@en ;
            ns2:name "action" ;
            ns2:title "Action"@en ] ;
    ns2:title "Operations record template"@en .

<dtmi:digitaltwins:isa95:OperationsRequest;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.379835+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.379836+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A request for an element of an operation schedule shall be presented as an operations request."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The segment requirements related to this operations request." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfRequirement" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The associated operations segments reference that corresponds to this operations request. If the operations segment reference is insufficient to identify the operations segment, then the segment requirement should also identify the operations definition reference." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToSegment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations definition reference that corresponds to this operations request." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToDefinition" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsDefinition;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The requested information to be returned in segment responses during the processing / execution of this this operations request." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfResponse" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:RequestedSegmentResponse;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "When operation is to be completed."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "examples: {Lowest, Low, Medium, High, Highest}" ;
            ns2:description "The priority of the request."@en ;
            ns2:name "priority" ;
            ns2:title "Priority"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "When operation is to be started."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "forecast" ],
                [ ns1:const "waiting" ],
                [ ns1:const "released" ],
                [ ns1:const "closed" ],
                [ ns1:const "ready" ],
                [ ns1:const "cancelled" ],
                [ ns1:const "completed" ],
                [ ns1:const "suspended" ],
                [ ns1:const "aborted" ],
                [ ns1:const "running" ],
                [ ns1:const "held" ] ;
            ns2:description "Indicates the state of the operations request."@en ;
            ns2:name "requestState" ;
            ns2:title "Request state"@en ] ;
    ns2:title "Operations request"@en .

<dtmi:digitaltwins:isa95:OperationsResponse;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.474948+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.474962+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The responses from manufacturing that are associated with an operations request shall be presented as operations responses."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The segment requirement(s) that corresponds to this operations response." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToRequirement" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations definition(s) that corresponds to this operations response if it exists or is relevant" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToDefinition" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations request that corresponds to this operations response if it exists or is relevant." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToRequest" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsRequest;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The operations segment(s) that corresponds to this operations response if it exists or is relevant." ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToSegment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The segment response(s) related to this operations response." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOfRequirement" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentResponse;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time of this operations response"@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "forecast" ],
                [ ns1:const "released" ],
                [ ns1:const "waiting" ],
                [ ns1:const "ready" ],
                [ ns1:const "aborted" ],
                [ ns1:const "cancelled" ],
                [ ns1:const "completed" ],
                [ ns1:const "held" ],
                [ ns1:const "suspended" ],
                [ ns1:const "closed" ],
                [ ns1:const "running" ] ;
            ns2:description "Indicates the state of the operations response."@en ;
            ns2:name "responseState" ;
            ns2:title "Response state"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time of this operations response"@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ] ;
    ns2:title "Operations response"@en .

<dtmi:digitaltwins:isa95:OperationsSchedule;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.378647+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.378649+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A request for operations to be performed shall be presented as an operations schedule."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The operations requests that make up the operations schedule." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsRequest;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time for the associated operations schedule."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "completed" ],
                [ ns1:const "forecast" ],
                [ ns1:const "held" ],
                [ ns1:const "aborted" ],
                [ ns1:const "running" ],
                [ ns1:const "ready" ],
                [ ns1:const "released" ],
                [ ns1:const "cancelled" ],
                [ ns1:const "closed" ],
                [ ns1:const "suspended" ],
                [ ns1:const "waiting" ] ;
            ns2:description "Indicates the state of the operations schedule."@en ;
            ns2:name "scheduleState" ;
            ns2:title "Schedule state"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time for the associated operations schedule."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ] ;
            ns2:description "Describes the category of operation"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time on which the test specification was published or generated"@en ;
            ns2:name "publishedDate" ;
            ns2:title "Published date"@en ] ;
    ns2:title "Operations schedule"@en .

<dtmi:digitaltwins:isa95:OperationsSegment;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.419043+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.419045+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The information needed to quantify a segment for a specific operation shall be presented as an operations segment. An operations segment identifies, references, or corresponds to a process segment. "@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The operations parameter specifications related to this operations segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsParameter" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ParameterSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset specification(s) defining part of this operations segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Operations segment has an association class relationship with segment dependency. The ordering / sequencing rules related to the operations segment execution" ;
            ns5:displayName "Has an execution dependency on" ;
            ns3:hasRelationType "dtdl:hasAnExecutionDependencyOnSegment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegmentDependency;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Operations segment has an association class relationship with operations dependency. The operations segment(s) applying the ordering / sequencing rules from the segment dependency related to the operations segment execution" ;
            ns5:displayName "Has an execution dependency on" ;
            ns3:hasRelationType "dtdl:hasAnExecutionDependencyOn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The personnel specification(s) defining part of this operations segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material specification(s) defining part of this operations segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment specification(s) defining part of this operations segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This operations segment class(s) include properties of the operations segment class" ;
            ns5:displayName "Includes properties of" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent operations segment is whole of the child operations segment(s) as the part" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The process segments correspond to this operations segment. I" ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "pattern" ;
                    ns2:description "a operations segment used as a template for other operations segments"@en ],
                [ ns1:const "instance" ;
                    ns2:description "a operations segment that may be directly scheduled and tracked"@en ] ;
            ns2:description "Defines the type of the process segment"@en ;
            ns2:name "definitionType" ;
            ns2:title "Definition type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Duration of process segment"@en ;
            ns2:name "duration" ;
            ns2:title "Duration"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The units of measure of the duration"@en ;
            ns2:name "durationUnitOfMeasure" ;
            ns2:title "Duration unit of measure"@en ] ;
    ns2:title "Operations segment"@en .

<dtmi:digitaltwins:isa95:OperationsSegmentCapability;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.443326+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.443346+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Other information related to the capability operations made shall be presented as segment data."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The equipment capability(s) related to this operations segment capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations segment related to this operations segment capability." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The personnel capability(s) related to this operations segment capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelCapability;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset capability(s) related to this operations segment capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetCapability;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material capability(s) related to this operations segment capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested operations segment capability(s) makes up part of this operations segment capability as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegmentCapability;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time of this capability type."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time of this capability type."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Measure of the confidence of the ability to obtain the capacity value."@en ;
            ns2:name "confidenceFactor" ;
            ns2:title "Confidence Factor"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the operations segment."@en ;
            ns2:name "operationsSegment" ;
            ns2:title "Operations segment"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the reason for the capability type."@en ;
            ns2:name "reason" ;
            ns2:title "Reason"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "capacity that is available for additional future productive use." ;
                    ns1:const "available" ],
                [ ns6:comment ": capacity that is committed for future productive use." ;
                    ns1:const "committed" ],
                [ ns6:comment "the sum of used and unused capability or the sum of available, unattainable and committed capability." ;
                    ns1:const "total" ],
                [ ns6:comment "a historical value that defines the portion of the capacity with acceptable quality." ;
                    ns1:const "used" ],
                [ ns6:comment " a historical value that defines the portion of the capacity that was not used or had unacceptable quality." ;
                    ns1:const "unused" ],
                [ ns6:comment "capacity that is not attainable for future productive use given the equipment condition, equipment utilization, personnel availability or material availability." ;
                    ns1:const "unattainable" ] ;
            ns2:description "Defines the type of capability. "@en ;
            ns2:name "capabilityType" ;
            ns2:title "Capability type"@en ] ;
    ns2:title "Operations segment capability"@en .

<dtmi:digitaltwins:isa95:OperationsSegmentDependency;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.413246+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.413260+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Operations dependencies that are independent of any particular product or operations task shall be presented as segment dependencies."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The source operations segment(s) that the target operations segment(s) are dependent. Operations segment has an association class relationship with segment dependency" ;
            ns5:displayName "Has an execution dependency on" ;
            ns3:hasRelationType "dtdl:operationsSegmentFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The target operations segment(s) that are dependent on source operations segment(s). Operations segment has an association class relationship with segment dependency" ;
            ns5:displayName "Has an execution dependency on" ;
            ns3:hasRelationType "dtdl:operationsSegmentTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Factor used by dependency"@en ;
            ns2:name "dependencyFactor" ;
            ns2:title "Dependency factor"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "noLaterAfterEnd" ;
                    ns2:description "start B no later than dependency factor after A end"@en ;
                    ns2:title "No later after end"@en ],
                [ ns1:const "noEarlierAfterEnd" ;
                    ns2:description " B no earlier than dependency factor after A end"@en ;
                    ns2:title "No earlier after end"@en ],
                [ ns1:const "possibleParallel" ;
                    ns2:description "B may run in parallel to A"@en ;
                    ns2:title "Possible parallel"@en ],
                [ ns1:const "notInParallel" ;
                    ns2:description "B may not run in parallel to A"@en ;
                    ns2:title "Not in parallel"@en ],
                [ ns1:const "afterEnd" ;
                    ns2:description "start B after A end"@en ;
                    ns2:title "After end"@en ],
                [ ns1:const "afterStart" ;
                    ns2:description "start B after A start"@en ;
                    ns2:title "After start"@en ],
                [ ns1:const "atStart" ;
                    ns2:description "start B at A start"@en ;
                    ns2:title "At start"@en ],
                [ ns1:const "notFollow" ;
                    ns2:description "B cannot follow A;"@en ;
                    ns2:title "Not follow"@en ],
                [ ns1:const "noLaterAfterStart" ;
                    ns2:description "start B no later than dependency factor after A start"@en ;
                    ns2:title "No later after start"@en ],
                [ ns1:const "noEarlierAfterStart" ;
                    ns2:description "start B no earlier than dependency factor after A start"@en ;
                    ns2:title "No earlier after start"@en ] ;
            ns2:description "Defines the execution dependency constraints of one segment to another segment.as the type of the execution or dependency factor between the segments"@en ;
            ns2:name "dependencyType" ;
            ns2:title "Dependency Type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The units of measure of the dependency factor"@en ;
            ns2:name "dependencyFactorUnitOfMeasure" ;
            ns2:title "Dependency factor unit of measure"@en ] ;
    ns2:title "Segment dependency"@en .

<dtmi:digitaltwins:isa95:OperationsTestRequirement;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.389768+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.389772+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The operations test requirements are represented as abstract interface objects to simplify the operations test model diagram"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The test specification(s) used to evaluate this operations test requirement" ;
            ns5:displayName "Specifies" ;
            ns3:hasRelationType "dtdl:specifies" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to a property element in the resource model for the testable object property as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to a property element in" ;
            ns3:hasRelationType "dtdl:mapsToAPropertyElementIn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to an element in the resource model for the testable object as explained in Clause 3.3.8. Identifies the associated testable object of this operations test requirement for a specific segment requirement" ;
            ns5:displayName "Corresponds to an element in" ;
            ns3:hasRelationType "dtdl:correspondsToAnElementIn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:title "Operations test requirement"@en .

<dtmi:digitaltwins:isa95:ParameterSpecification;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.416782+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.416784+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specific parameters required for an operations segment shall be presented as parameter specifications. An operations segment may have an associated set of zero or more parameter specifications."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The child parameter specification(s) that are part of the parameter segment parameter as the whole" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ParameterSpecification;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition hierarchy" ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined"@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Parameter specification"@en .

<dtmi:digitaltwins:isa95:Person;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.424644+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.424654+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A  representation  of  a  specifically  identified  individual shall  be  presented  as  a person. A person may be a member of zero or more personnel classes."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Personnel classes supported by this person.This person supports the personnel class property(s) associated with the personnel class." ;
            ns5:displayName "Defined by" ;
            ns3:hasRelationType "dtdl:definedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelClass;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Association" ],
        [ a ns5:Relationship ;
            ns5:description "The person property values of this person." ;
            ns5:displayName "Has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObject;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the personas a zero-dimensional point, one-dimensional line, or two-dimensional shape or three-dimensional solid,/ / WKT / POLYGON ( ( -646.99 676.18, -645.14 683.09, -" ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to operational location." ;
            ns5:displayName "fits operational location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:operationalLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Additional information about the resource." ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The name of the individual.This is meant as an additional identification of the resource, but only as information and not as a unique value."@en ;
            ns2:name "name" ;
            ns2:title "Name"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "operationalLocation" ;
                    ns2:description "operational location attribute references an operational location;"@en ;
                    ns2:title "Operational Location"@en ],
                [ ns1:const "description" ;
                    ns2:description "operational location attribute contains a description of the operational location, such as a street address."@en ;
                    ns2:title "Description"@en ] ;
            ns2:description "Indicates whether the operational location attribute refers to an operational location object or contains a description of the operational location.Mandatory where an operational location attribute is specified.Defined values are operational location:operational location attribute references an operational location;description:operational location attribute contains a description of the operational location, such as a street address."@en ;
            ns2:name "operationalLocationType" ;
            ns2:title "Operational location type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role-based equipment hierarchy. Optionally, hierarchy scope defines the scope of the person definition."@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the operational location of the person."@en ;
            ns2:name "operationalLocation" ;
            ns2:title "Operational location"@en ] ;
    ns2:title "Person"@en .

<dtmi:digitaltwins:isa95:PersonProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.422263+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.422267+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Properties  of  a person shall  be  presented as person  properties. Each person shall  have  zero  or more person properties. These specify the current property values of the person for the associated personnel class property. "@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "This nested person property(s)is part of the person property as the whole." ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition hierarchy" ],
        [ a ns5:Relationship ;
            ns5:description "If the person supports the parent personnel class,the personnel class property(s)is applied in this person property(s). " ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelClassProperty;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Dependency" ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceProperty;1"^^xsd:anyURI ] ;
    ns2:title "Person property"@en .

<dtmi:digitaltwins:isa95:PersonnelActual;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.453467+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.453472+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "An identification of a personnel capability used during a specified segment response shall be presented as personnel actual."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to operational location." ;
            ns5:displayName "fits operational location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:operationalLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the personnel model as explained in Clause 3.3.8. Identifies the associated person or set of persons specified. Typically, either personnel class or person is specified, but not both" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToPerson" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Person;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The values in the personnel actual property are for this personnel actual." ;
            ns5:displayName "has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelActualProperty;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this personnel actual as the whole" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelActual;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the personnel model as explained in Clause 3.3.8. Identifies the associated personnel class or set of personnel classes specified" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToPersonnelClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelClass;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceActual;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the operational location of the personnel resource(s)  specified by this personnel segment specification"@en ;
            ns2:name "operationalLocation" ;
            ns2:title "Operational location"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the personnel resource used for the parent segment"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "description" ;
                    ns2:description "operational location attribute contains a description of the operational location, such as a street address."@en ;
                    ns2:title "Description"@en ],
                [ ns1:const "operationalLocation" ;
                    ns2:description "operational location attribute references an operational location;"@en ;
                    ns2:title "Operational Location"@en ] ;
            ns2:description "Indicates whether the operational location attribute refers to an operational location object or contains a description of the operational location. Mandatory where an operational location attribute is specified"@en ;
            ns2:name "operationalLocationType" ;
            ns2:title "Operational location type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the actual use of the personnel class or personnel in the context of the parent segment"@en ;
            ns2:name "personnelUse" ;
            ns2:title "Personnel use"@en ] ;
    ns2:title "Personnel actual"@en .

<dtmi:digitaltwins:isa95:PersonnelActualProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.470727+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.470738+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specific properties that are required for a personnel actual shall be presented as personnel actual properties."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the personnel model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
