    dcterms:modified "2024-01-17T15:53:51.377575+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The identification of the number, type, duration, and scheduling of specific certifications and job classifications needed to support the current operations request shall be presented as personnel requirements."@en ;
