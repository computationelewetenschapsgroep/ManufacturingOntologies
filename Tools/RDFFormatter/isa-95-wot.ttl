<dtmi:digitaltwins:isa95:PhysicalAssetSpecification;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.416529+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.416532+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Physical asset resources that are required for a operations segment shall be presented as physical asset specifications"@en ;
    ns2:hasLink [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the physical asset model as explained in Clause 3.3.8. Identifies the associated physical asset class or set of physical asset classes of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToPhysicalAssetClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The test specification(s) used to evaluate this testable object." ;
            ns5:displayName "Specifies" ;
            ns3:hasRelationType "dtdl:specifies" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this physical asset specification as the whole" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset specification property(s) of this physical asset specification" ;
            ns5:displayName "has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetSpecificationProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to physical location." ;
            ns5:displayName "fits physical location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:physicalLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the physical asset model as explained in Clause 3.3.8. Identifies the associated physical asset or set of physical assets of the specification for a specific process segment. Typically, either physical asset class or physical asset is specified, but not both" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAsset;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources required"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the expected use of the physical asset class or physical asset in the context of the process segment"@en ;
            ns2:name "physicalAssetUse" ;
            ns2:title "Physical asset use"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "description" ;
                    ns2:description " physical location attribute contains a description of the physical location, such as a street address."@en ;
                    ns2:title "Description"@en ],
                [ ns1:const "operationalLocation" ;
                    ns2:description "physical location attribute references an operational location"@en ;
                    ns2:title "Operational Location"@en ] ;
            ns2:description "Indicates whether the physical location attribute refers to an operational location object or contains a description of the physical location. Mandatory where a physical location attribute is specified"@en ;
            ns2:name "physicalLocationType" ;
            ns2:title "Physical location type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the physical location of the physical asset(s) specified by this physical asset segment specification"@en ;
            ns2:name "physicalLocation" ;
            ns2:title "Physical location"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Physical Asset specification"@en .

<dtmi:digitaltwins:isa95:PhysicalAssetSpecificationProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.421660+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.421670+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specific properties that are required for physical asset specifications shall be presented as physical asset specification property(s)"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the physical asset model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset specification property(s) of this physical asset specification property" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetSpecificationProperty;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions of the property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model dependency to element in the physical asset model as explained in Clause 3.3.8" ;
            ns5:displayName "Maps to" ;
            ns3:hasRelationType "dtdl:mapsToClassProperty" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetClassProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources required"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ] ;
    ns2:title "Physical Asset specification property"@en .

<dtmi:digitaltwins:isa95:ProcessCell;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.234487+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.234488+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "Process cells and units are the lowest level of equipment typically scheduled by the Level 4 and Level 3 functions for batch manufacturing processes. "@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkCenter;1"^^xsd:anyURI ] ;
    ns2:title "Process cell"@en .

<dtmi:digitaltwins:isa95:ProcessSegment;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.498434+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.498444+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A process segment lists the classes of personnel, equipment, physical assets, and material needed, and/or it may present specific resources, such as specific equipment needed for the process segment. A process segment may list the quantity of the resource needed. A process segment is something that occurs or can occur during manufacturing operations"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Process segment has an association class relationship with segment dependency. The ordering / sequencing rules related to the process segment execution" ;
            ns5:displayName "Has an execution dependency on" ;
            ns3:hasRelationType "dtdl:hasAnExecutionDependencyOnSegment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegmentDependency;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parent process segment is whole of the child process segment(s) as the part" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset specification(s) defining part of this process segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPhysicalAssetSpecification" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetSegmentSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment specification(s) defining part of this process segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsEquipmentSpecification" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentSegmentSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This process segment class(s) include properties of the process segment class" ;
            ns5:displayName "Includes properties of" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:includesPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:Resource;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The process parameter specifications related to this process segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsParameter" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegmentParameter;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The personnel specification(s) defining part of this process segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsPersonnelSpecification" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelSegmentSpecification;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Process segment has an association class relationship with segment dependency. The process segment(s) applying the ordering / sequencing rules from the segment dependency related to the process segment execution" ;
            ns5:displayName "Has an execution dependency on" ;
            ns3:hasRelationType "dtdl:hasAnExecutionDependencyOn" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material specification(s) defining part of this process segment" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsMaterialSpecification" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialSegmentSpecification;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Duration of process segment"@en ;
            ns2:name "duration" ;
            ns2:title "Duration"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The units of measure of the duration"@en ;
            ns2:name "durationUnitOfMeasure" ;
            ns2:title "Duration unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "instance" ;
                    ns2:description "a process segment that may be directly scheduled and tracked"@en ],
                [ ns1:const "pattern" ;
                    ns2:description "a process segment used as a template for other process segments"@en ] ;
            ns2:description "Defines the type of the process segment"@en ;
            ns2:name "definitionType" ;
            ns2:title "Definition type"@en ] ;
    ns2:title "Process segment"@en .

<dtmi:digitaltwins:isa95:ProcessSegmentCapability;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.428562+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.428578+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A representation of a logical grouping of personnel resources, equipment resources, physical asset resources, and material that is committed, available, or unavailable for a given process segment for a specific time shall be presented as a process segment capability."@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The personnel capability(s) related to this process segment capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfPersonnel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PersonnelCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The material capability(s) related to this process segment capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfMaterial" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:MaterialCapability;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The nested process segment capability(s) makes up part of this process segment capability as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegmentCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The physical asset capability(s) related to this process segment capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The equipment capability(s) related to this process segment capability." ;
            ns5:displayName "Is a collection of" ;
            ns3:hasRelationType "dtdl:isACollectionOfEquipment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:EquipmentCapability;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The process segment related to this process segment capability." ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time of this capability type."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the reason for the capability type."@en ;
            ns2:name "reason" ;
            ns2:title "Reason"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ],
                [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time of this capability type."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "the sum of used and unused capability or the sum of available, unattainable and committed capability." ;
                    ns1:const "total" ],
                [ ns6:comment "capacity that is not attainable for future productive use given the equipment condition, equipment utilization, personnel availability or material availability." ;
                    ns1:const "unattainable" ],
                [ ns6:comment "a historical value that defines the portion of the capacity with acceptable quality." ;
                    ns1:const "used" ],
                [ ns6:comment "capacity that is available for additional future productive use." ;
                    ns1:const "available" ],
                [ ns6:comment ": capacity that is committed for future productive use." ;
                    ns1:const "committed" ],
                [ ns6:comment " a historical value that defines the portion of the capacity that was not used or had unacceptable quality." ;
                    ns1:const "unused" ] ;
            ns2:description "Defines the type of capability. "@en ;
            ns2:name "capabilityType" ;
            ns2:title "Capability type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Measure of the confidence of the ability to obtain the capacity value."@en ;
            ns2:name "confidenceFactor" ;
            ns2:title "Confidence Factor"@en ] ;
    ns2:title "Process segment capability"@en .

<dtmi:digitaltwins:isa95:ProcessSegmentDependency;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.493625+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.493632+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Process dependencies that are independent of any particular product or operations task shall be presented as segment dependencies."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The source process segment(s) that the target process segment(s) are dependent. Process segment has an association class relationship with segment dependency" ;
            ns5:displayName "Has an execution dependency on" ;
            ns3:hasRelationType "dtdl:processSegmentFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The target process segment(s) that are dependent on source process segment(s).Process segment has an association class relationship with segment dependency" ;
            ns5:displayName "Has an execution dependency on" ;
            ns3:hasRelationType "dtdl:processSegmentTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The units of measure of the dependency factor"@en ;
            ns2:name "dependencyFactorUnitOfMeasure" ;
            ns2:title "Dependency factor unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "noEarlierAfterEnd" ;
                    ns2:description " B no earlier than dependency factor after A end"@en ;
                    ns2:title "No earlier after end"@en ],
                [ ns1:const "afterEnd" ;
                    ns2:description "start B after A end"@en ;
                    ns2:title "After end"@en ],
                [ ns1:const "noLaterAfterEnd" ;
                    ns2:description "start B no later than dependency factor after A end"@en ;
                    ns2:title "No later after end"@en ],
                [ ns1:const "noEarlierAfterStart" ;
                    ns2:description "start B no earlier than dependency factor after A start"@en ;
                    ns2:title "No earlier after start"@en ],
                [ ns1:const "notInParallel" ;
                    ns2:description "B may not run in parallel to A"@en ;
                    ns2:title "Not in parallel"@en ],
                [ ns1:const "noLaterAfterStart" ;
                    ns2:description "start B no later than dependency factor after A start"@en ;
                    ns2:title "No later after start"@en ],
                [ ns1:const "possibleParallel" ;
                    ns2:description "B may run in parallel to A"@en ;
                    ns2:title "Possible parallel"@en ],
                [ ns1:const "notFollow" ;
                    ns2:description "B cannot follow A;"@en ;
                    ns2:title "Not follow"@en ],
                [ ns1:const "atStart" ;
                    ns2:description "start B at A start"@en ;
                    ns2:title "At start"@en ],
                [ ns1:const "afterStart" ;
                    ns2:description "start B after A start"@en ;
                    ns2:title "After start"@en ] ;
            ns2:description "Defines the execution dependency constraints of one segment to another segment.as the type of the execution or dependency factor between the segments"@en ;
            ns2:name "dependencyType" ;
            ns2:title "Dependency Type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Factor used by dependency"@en ;
            ns2:name "dependencyFactor" ;
            ns2:title "Dependency factor"@en ] ;
    ns2:title "Segment dependency"@en .

<dtmi:digitaltwins:isa95:ProcessSegmentParameter;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.487592+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.487600+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "Specific parameters required for a process segment shall be presented as process segment parameters. Process segment parameters may contain nested process segment parameters"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "This parameter segment parameter is part of the parameter segment parameter as the whole" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegmentParameter;1"^^xsd:anyURI ;
            ns7:comment "Relationship type: Composition hierarchy" ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. Optionally, hierarchy scopedefines the scope of the physical asset class, such as the site or area where it is defined"@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ] ;
    ns2:title "Process segment parameter"@en .

<dtmi:digitaltwins:isa95:ProductionLine;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.234349+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.234350+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "Production lines and work cells are the lowest levels of equipment typically scheduled by the Level 4 or Level 3 functions for discrete manufacturing processes. "@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkCenter;1"^^xsd:anyURI ] ;
    ns2:title "Production line"@en .

<dtmi:digitaltwins:isa95:ProductionUnit;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.234621+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.234621+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.01-2010 (IEC 62264-1 Mod) Enterprise-Control System Integration − Part 1: Models and Terminology - Approved 13 May 2010" ;
    ns2:description "A production unit generally encompasses all of the equipment required for a segment of continuous production that operates in a relatively autonomous manner. "@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkCenter;1"^^xsd:anyURI ] ;
    ns2:title "Production unit"@en .

<dtmi:digitaltwins:isa95:PropertyMeasurement;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.403894+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.403900+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The measurement obtained during execution of work master (defined in Part 4 of this standard) shall be presented as a property measurement. A property measurement reports the measurement obtained for a single testable object property corresponding to an evaluated property of a test specification for a specific person, equipment, physical asset, material lot or material sublot"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The work master ID or work directive ID which is applied test method to obtain the measurement of this property measurement for test specification of the testable object property ID" ;
            ns5:displayName "Measured with method of" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:measuredWithMethodOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:WorkDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The testable object property ID for which this property measurement is records the measurement result" ;
            ns5:displayName "Records measurement of" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:recordsMeasurementOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestableObjectProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the property measurement" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The measured value for the testable object property"@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the measured value, if applicable"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time when the measurement was obtained"@en ;
            ns2:name "measurementDate" ;
            ns2:title "Measurement date"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date of the expiration of the property measurement"@en ;
            ns2:name "expiration" ;
            ns2:title "Expiration"@en ] ;
    ns2:title "Property measurement"@en .

<dtmi:digitaltwins:isa95:RequestedSegmentResponse;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.381580+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.381582+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The identification of the informaiton sent back as a result of the oprations request shall be presented as a requested segment response"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The segments requirement(s) that corresponds to this segment response" ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToRequirement" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentRequirement;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns5:description "Additional information about the process segment" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "An identification of the process segment associated with this segment response." ;
            ns5:displayName "Corresponds To a" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:correspondsToAProcessSegment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ProcessSegment;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The segment parameters related to this segment response" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:containsData" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentData;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this segment response as the whole." ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SegmentResponse;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The operations definition reference that corresponds to this segment response" ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToDefinition" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The associated operations segments that corresponds to this segment response" ;
            ns5:displayName "Corresponds To" ;
            ns3:hasRelationType "dtdl:correspondsToSegment" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationsSegment;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The expected earliest start time of this segment requirement."@en ;
            ns2:name "earliestStartTime" ;
            ns2:title "Earliest Start Time"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The date and time used for posting resource actuals to supporting applications."@en ;
            ns2:name "postingDate" ;
            ns2:title "Posting Date"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The actual end time of this segment response."@en ;
            ns2:name "latestEndTime" ;
            ns2:title "Latest End Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "suspended" ],
                [ ns1:const "running" ],
                [ ns1:const "completed" ],
                [ ns1:const "cancelled" ],
                [ ns1:const "closed" ],
                [ ns1:const "aborted" ],
                [ ns1:const "waiting" ],
                [ ns1:const "held" ],
                [ ns1:const "ready" ],
                [ ns1:const "released" ],
                [ ns1:const "forecast" ] ;
            ns2:description "Indicates the state of the segment response."@en ;
            ns2:name "segmentState" ;
            ns2:title "Segment state"@en ],
        [ a ns1:StringSchema ;
            ns1:comment "Required attribute. Possible values are: production, maintenance, quality, inventory, or mixed" ;
            ns1:oneOf [ ns1:const "quality" ;
                    ns2:title "Quality"@en ],
                [ ns1:const "maintenance" ;
                    ns2:title "Maintenance"@en ],
                [ ns1:const "production" ;
                    ns2:title "Production"@en ],
                [ ns1:const "inventory" ;
                    ns2:title "Inventory"@en ],
                [ ns6:comment " can be used when the activity contains several categories of process segments" ;
                    ns1:const "mixed" ;
                    ns2:title "Mixed"@en ] ;
            ns2:description "Describes the category of the activity"@en ;
            ns2:name "operationsType" ;
            ns2:title "Operations type"@en ] ;
    ns2:title "Requested segment response"@en .

<dtmi:digitaltwins:isa95:Resource;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.252498+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.252499+01:00"^^xsd:dateTime ;
    ns2:description "Abstract model for all resource models (person, equipment, physical asset, material definition, material lot, material sublot, work master, process segment, operation definition, operational location, operations segment, test specification, test result)"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:title "Resource"@en .

<dtmi:digitaltwins:isa95:ResourceActual;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.386479+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.386493+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "/Abstract/ The resource actual represents an abstract interface object to simplify the operations test model diagram. The interface object represents the objects that can report test result(s)"@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "This resource actual reports the test result in a segment response or job response (Defined in Part 4)." ;
            ns5:displayName "Reports" ;
            ns3:hasRelationType "dtdl:reports" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:TestResult;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:title "Resource actual"@en .

<dtmi:digitaltwins:isa95:ResourceClass;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.235070+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.235070+01:00"^^xsd:dateTime ;
    ns2:description "Abstract model for all resource class models (person class, equipment class, physical asset class, material class)"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ] ;
    ns2:title "Resource class"@en .

<dtmi:digitaltwins:isa95:ResourceClassProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.250205+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.250209+01:00"^^xsd:dateTime ;
    ns2:description "Abstract model for all resource class property models (person class, equipment class, physical asset class, material class)"@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Additional information about the resource class property" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "instanceType" ;
                    ns2:description "the property value of the class is undefined"@en ;
                    ns2:title "Instance Type"@en ],
                [ ns1:const "defaultType" ;
                    ns2:description "The property value is defined for the class as the default instance value, but individual instances of the class may redefine specific values."@en ;
                    ns2:title "Default Type"@en ],
                [ ns1:const "classType" ;
                    ns2:description "The property value is defined for the class and there is no value associated with an instance"@en ;
                    ns2:title "Class Type"@en ] ;
            ns2:description "Defines the type of the property."@en ;
            ns2:name "propertyType" ;
            ns2:title "Property type"@en ] ;
    ns2:title "Resource class property"@en .

<dtmi:digitaltwins:isa95:ResourceNetworkConnection;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.557583+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.557586+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "The directed relationship between two resources in a resource relationship network shall be defined as a resource network connection."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The from resource reference to which this resource network connection connects" ;
            ns5:displayName "Connects From" ;
            ns3:hasRelationType "dtdl:connectsFrom" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:FromResourceReference;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The resource network connection type defining this resource network connection." ;
            ns5:displayName "Defined By" ;
            ns3:hasRelationType "dtdl:definedBy" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceNetworkConnectionType;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The to resource reference to which this resource network connection connects" ;
            ns5:displayName "Connects To" ;
            ns3:hasRelationType "dtdl:connectsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ToResourceReference;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The resource network connection property(s) related to this resource network connection." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceNetworkConnectionProperty;1"^^xsd:anyURI ] ;
    ns2:title "Resource network connection"@en .

<dtmi:digitaltwins:isa95:ResourceNetworkConnectionProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.561712+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.561714+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A property of a resource network connection shall be defined as a resource network connection property. "@en ;
    ns2:hasLink [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The nested resource network connection properties of this resource network connection property" ;
            ns5:displayName "Contains" ;
            ns3:hasRelationType "dtdl:contains" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceNetworkConnectionProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The resource network connection type property(s) of the resource network connection type defines this resource network connection property(s) when derived from a specific resource network connection type." ;
            ns5:displayName "Maps To" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceNetworkConnectionTypeProperty;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "The value, set of values, or range of the property."@en ;
            ns2:name "value" ;
            ns2:title "Value"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated property value"@en ;
            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ] ;
    ns2:title "Resource network connection property"@en .

<dtmi:digitaltwins:isa95:ResourceNetworkConnectionType;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.561969+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.561971+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A definition of a type of a resource network connection shall be defined as a resource network connection type."@en ;
    ns2:hasLink [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The resource network connection type property(s) related to this resource network connection type." ;
            ns5:displayName "Has properties of" ;
            ns3:hasRelationType "dtdl:hasPropertiesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceNetworkConnectionTypeProperty;1"^^xsd:anyURI ],
        [ ns5:description "The connection type" ;
            ns5:displayName "Type" ;
            ns5:name "type" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:title "Resource network connection type"@en .

<dtmi:digitaltwins:isa95:ResourceNetworkConnectionTypeProperty;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.560966+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.560996+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.04-2018 Enterprise-Control System Integration − Part 4: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A 'from' reference to a resource shall be defined as a from resource reference."@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "The resource network connection property(s) derived from this resource network connection type property supporting its parent object. Only applied, if navigation is required." ;
            ns5:displayName "Maps To" ;
            ns3:hasRelationType "dtdl:mapsTo" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:ResourceNetworkConnectionProperty;1"^^xsd:anyURI ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions" ;
