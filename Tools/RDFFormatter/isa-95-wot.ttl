            ns2:name "valueUnitOfMeasure" ;
            ns2:title "Value unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ] ;
    ns2:title "Physical Asset actual property"@en .

<dtmi:digitaltwins:isa95:PhysicalAssetCapability;1> a <https://www.w3.org/2019/wot/tm#ThingModel> ;
    dcterms:created "2024-01-17T15:53:51.440949+01:00"^^xsd:dateTime ;
    dcterms:modified "2024-01-17T15:53:51.440961+01:00"^^xsd:dateTime ;
    ns4:comment "According to ANSI/ISA-95.00.02-2018 Enterprise-Control System Integration − Part 2: Objects and Attributes for - Approved 24 May 2018" ;
    ns2:description "A representation of the capability of a physical asset or physical asset class that is committed, available, or unattainable for a specific time shall be presented as a physical asset capability. "@en ;
    ns2:hasLink [ a ns5:Relationship ;
            ns5:description "Optional relationship to hierarchy." ;
            ns5:displayName "fits hierarchy scope" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:hierarchyScopeRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:HierarchyScope;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ a ns5:Relationship ;
            ns5:description "The values in the physical asset capability property are for this physical asset capability." ;
            ns5:displayName "has values of" ;
            ns3:hasRelationType "dtdl:hasValuesOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:physicalAssetCapabilityProperty;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the physical asset model as explained in Clause 3.3.8. Identifies the associated physical asset or set of physical assets of the specification for a specific process segment. Typically, either physical asset class or physical asset is specified, but not both" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToPhysicalAsset" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAsset;1"^^xsd:anyURI ],
        [ ns5:description "Spatially defines the equipment as a zero-dimensional point, one dimensional line, or two dimensional shape or three dimensional solid." ;
            ns5:displayName "Spatial definition" ;
            ns5:name "spatialDefinition" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:SpatialDefinition;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "A cross-model association to element in the physical asset model as explained in Clause 3.3.8. Identifies the associated physical asset class or set of physical asset classes of the specification for a specific process segment" ;
            ns5:displayName "Corresponds to" ;
            ns3:hasRelationType "dtdl:correspondsToPhysicalAssetClass" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetClass;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "Optional relationship to physical location." ;
            ns5:displayName "fits physical location" ;
            ns5:maxMultiplicity 1 ;
            ns3:hasRelationType "dtdl:physicalLocationRel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:OperationalLocation;1"^^xsd:anyURI ;
            ns7:comment "Not part of the Standard Specs." ],
        [ ns3:hasRelationType "tm:extends" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:BaseModel;1"^^xsd:anyURI ],
        [ a ns5:Relationship ;
            ns5:description "The related object(s) makes up part of this physical asset capability as the whole" ;
            ns5:displayName "Is made up of" ;
            ns3:hasRelationType "dtdl:isMadeUpOf" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:PhysicalAssetCapability;1"^^xsd:anyURI ],
        [ ns5:description "Contains additional information and descriptions" ;
            ns5:displayName "Description" ;
            ns5:name "description" ;
            ns3:hasRelationType "tm:submodel" ;
            ns3:hasTarget "dtmi:digitaltwins:isa95:LangStringSet;1"^^xsd:anyURI ] ;
    ns2:hasPropertyAffordance [ a ns1:StringSchema ;
            ns2:description "Defines the capability use of the physical asset class or physical asset in the context of the parent segment"@en ;
            ns2:name "physicalAssetUse" ;
            ns2:title "Physical asset use"@en ],
        [ a ns1:StringSchema ;
            ns2:description "The unit of measure of the associated quantity"@en ;
            ns2:name "quantityUnitOfMeasure" ;
            ns2:title "Quantity unit of measure"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The ending time associated with the physical asset capability."@en ;
            ns2:name "endTime" ;
            ns2:title "End Time"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Defines the reason for the capability type."@en ;
            ns2:name "reason" ;
            ns2:title "Reason"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies the physical location of the physical asset(s) specified by this physical asset segment specification"@en ;
            ns2:name "physicalLocation" ;
            ns2:title "Physical location"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns1:const "operationalLocation" ;
                    ns2:description "physical location attribute references an operational location"@en ;
                    ns2:title "Operational Location"@en ],
                [ ns1:const "description" ;
                    ns2:description " physical location attribute contains a description of the physical location, such as a street address."@en ;
                    ns2:title "Description"@en ] ;
            ns2:description "Indicates whether the physical location attribute refers to an operational location object or contains a description of the physical location. Mandatory where a physical location attribute is specified"@en ;
            ns2:name "physicalLocationType" ;
            ns2:title "Physical location type"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Measure of the confidence of the ability to obtain the capacity value."@en ;
            ns2:name "confidenceFactor" ;
            ns2:title "Confidence Factor"@en ],
        [ a ns1:StringSchema ;
            ns2:description "Identifies where the exchanged information fits within the role based equipment hierarchy. "@en ;
            ns2:name "hierarchyScope" ;
            ns2:title "Hierarchy scope"@en ],
        [ a ns1:StringSchema ;
            ns1:oneOf [ ns6:comment "a historical value that defines the portion of the capacity with acceptable quality." ;
                    ns1:const "used" ],
                [ ns6:comment ": capacity that is committed for future productive use." ;
                    ns1:const "committed" ],
                [ ns6:comment "capacity that is not attainable for future productive use given the equipment condition, equipment utilization, personnel availability or material availability." ;
                    ns1:const "unattainable" ],
                [ ns6:comment " a historical value that defines the portion of the capacity that was not used or had unacceptable quality." ;
                    ns1:const "unused" ],
                [ ns6:comment "capacity that is available for additional future productive use." ;
                    ns1:const "available" ],
                [ ns6:comment "the sum of used and unused capability or the sum of available, unattainable and committed capability." ;
                    ns1:const "total" ] ;
            ns2:description "Defines the type of capability. "@en ;
            ns2:name "capabilityType" ;
            ns2:title "Capability type"@en ],
        [ a ns1:StringSchema ;
            ns1:format "date-time" ;
            ns2:description "The starting time associated with the physical asset capability."@en ;
            ns2:name "startTime" ;
            ns2:title "Start Time"@en ],
        [ a xsd:double,
                ns1:NumberSchema ;
            ns2:description "Specifies the amount of resources used"@en ;
            ns2:name "quantity" ;
            ns2:title "Quantity"@en ] ;
    ns2:title "Physical Asset capability"@en .

